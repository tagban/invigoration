<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invigoration.Core\Invigoration.Core.csproj" />
    <!-- Same AssemblyName override Invigoration.Core/App use, and for the same reason: without
         it, MSBuild treats this project's transitive view of Stimpak.csproj as a separate
         instance from Core's own (different global properties), rebuilding it with the default
         (colliding-on-Windows) name — see Invigoration.Core.csproj's comment for the full story. -->
    <ProjectReference Include="..\..\..\native\superiority\stimpak\csharp\Stimpak\Stimpak.csproj">
      <AdditionalProperties>StimpakBuildNative=false;AssemblyName=Stimpak.Managed</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Import Project="..\StimpakNativeAssets.props" />

</Project>