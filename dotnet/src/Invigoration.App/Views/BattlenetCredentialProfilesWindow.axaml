<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Invigoration.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="520"
        x:Class="Invigoration.App.Views.BattlenetCredentialProfilesWindow"
        x:DataType="vm:BattlenetCredentialProfilesViewModel"
        Width="560" Height="520"
        Title="Manage Battle.net Profiles">

    <Design.DataContext>
        <vm:BattlenetCredentialProfilesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Pinned so Save/Close are always reachable without scrolling through every profile below -->
        <Border Grid.Row="0" Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Manage Battle.net Profiles" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Close" Click="OnCloseClick" />
                    <Button Content="Save" Click="OnSaveClick" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16" Spacing="10">
                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11"
                           Text="Each profile is one signed-in Battle.net login. Assign the same profile to two bots (e.g. an SC2 bot and a future WC3:Reforged bot) to share one login instead of signing in twice." />

                <TextBlock Text="{Binding StatusMessage}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           TextWrapping="Wrap" Foreground="OrangeRed" FontSize="11" />

                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BattlenetCredentialProfileViewModel">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Name}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Signed in" Foreground="LightGreen" VerticalAlignment="Center"
                                               IsVisible="{Binding IsSignedIn}" FontSize="11" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Not signed in" Opacity="0.6" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsSignedIn}" FontSize="11" />
                                    <Button Grid.Row="0" Grid.Column="2" Content="Sign In..." Click="OnSignInClick"
                                            IsEnabled="{Binding !IsSigningIn}" />
                                    <Button Grid.Row="0" Grid.Column="3" Content="Remove"
                                            Command="{Binding $parent[ItemsControl].((vm:BattlenetCredentialProfilesViewModel)DataContext).RemoveProfileCommand}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                               Text="{Binding BattleTag, StringFormat='Signed in as {0}'}"
                                               IsVisible="{Binding BattleTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Opacity="0.6" FontSize="11" Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ Add Profile" Command="{Binding AddProfileCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
