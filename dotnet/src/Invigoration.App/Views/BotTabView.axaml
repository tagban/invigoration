<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Invigoration.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Invigoration.App.Views.BotTabView"
             x:DataType="vm:BotTabViewModel">

    <Grid ColumnDefinitions="*,180" RowDefinitions="Auto,*,Auto">

        <!-- Status / connect bar -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Spacing="8" Margin="8">
            <Button Content="Connect" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsConnected}" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <CheckBox Content="Debug logging" IsChecked="{Binding DebugMode}" Margin="16,0,0,0" />
        </StackPanel>

        <!-- Chat log: one continuous SelectableTextBlock (built up in code-behind)
             so drag-select and Ctrl+C work across whole lines and multiple
             lines at once, not just within a single colored segment. -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Name="ChatScroll">
            <SelectableTextBlock Name="ChatText" Margin="8" TextWrapping="Wrap" />
        </ScrollViewer>

        <!-- Channel user list: black background to match the icon set's own black backgrounds -->
        <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ChannelUsers}" Margin="0,0,8,0"
                 Background="Black">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8,1" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Image Grid.Column="0" Source="{Binding ProductIconImage}" Width="32" Height="16"
                               Stretch="Uniform" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="6,0">
                            <TextBlock Text="{Binding Username}" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Ping}" Foreground="White" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <Image Grid.Column="2" Source="{Binding StatusIconImage}" Width="22" Height="22"
                               Stretch="Uniform" VerticalAlignment="Center"
                               IsVisible="{Binding StatusIconImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Input -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="8">
            <TextBox Grid.Column="0" Name="InputBox" Text="{Binding InputText}" PlaceholderText="Type a message or /command..." />
            <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0" />
        </Grid>

    </Grid>
</UserControl>
