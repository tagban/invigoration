<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Invigoration.App.ViewModels"
             xmlns:stimpak="using:Stimpak"
             xmlns:views="using:Invigoration.App.Views"
             xmlns:conv="using:Invigoration.App.Converters"
             xmlns:models="using:Invigoration.App.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Invigoration.App.Views.BotTabView"
             x:DataType="vm:BotTabViewModel">

    <!-- D2 Style's palette of materials, shared by the frame around the chat and the restyled
         input row: dark weathered stone, a speckle laid over it so the bands read as carved rock
         rather than flat paint, and the tarnished gold Diablo II trims its menus with. -->
    <UserControl.Resources>
        <LinearGradientBrush x:Key="D2StoneBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#4A4238" Offset="0" />
            <GradientStop Color="#2B2620" Offset="0.45" />
            <GradientStop Color="#181511" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="D2CapBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#6A5E4E" Offset="0" />
            <GradientStop Color="#3A332A" Offset="0.5" />
            <GradientStop Color="#1E1A15" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="D2GoldBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#E3C67E" Offset="0" />
            <GradientStop Color="#A8894C" Offset="0.5" />
            <GradientStop Color="#6B5430" Offset="1" />
        </LinearGradientBrush>
        <DrawingBrush x:Key="D2GrainBrush" TileMode="Tile" DestinationRect="0,0,9,9" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000" Geometry="M 0,0 H 9 V 9 H 0 Z" />
                    <GeometryDrawing Brush="#1FFFFFFF" Geometry="M 1,1 h 1 v 1 h -1 Z M 6,3 h 1 v 1 h -1 Z M 3,7 h 1 v 1 h -1 Z" />
                    <GeometryDrawing Brush="#40000000" Geometry="M 4,0 h 2 v 1 h -2 Z M 0,5 h 1 v 2 h -1 Z M 7,6 h 1 v 1 h -1 Z M 5,5 h 1 v 1 h -1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- A square cast-metal corner block with a gold diamond rivet, stamped onto each corner of
             the D2 frame. A templated ContentControl so the four corners share one definition. -->
        <Style Selector="ContentControl.d2cap">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Background="{StaticResource D2CapBrush}" BorderBrush="#000000" BorderThickness="1" />
                        <Border Margin="2" BorderBrush="{StaticResource D2GoldBrush}" BorderThickness="1" />
                        <Path Data="M 5,0 L 10,5 L 5,10 L 0,5 Z" Fill="{StaticResource D2GoldBrush}"
                              Stroke="#000000" StrokeThickness="1"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- A small domed rivet set into the stone bands between the corners. -->
        <Style Selector="ContentControl.d2stud">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Ellipse Stroke="#000000" StrokeThickness="1">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="30%,30%" Center="40%,40%">
                                <GradientStop Color="#F0DCA0" Offset="0" />
                                <GradientStop Color="#9C7D44" Offset="0.55" />
                                <GradientStop Color="#3E3020" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- D2 Style's input row: a black text well with a gold rim, and a stone Send button with
             gold serif lettering. Fluent restyles both controls per state from inside their
             templates, so each state is overridden there too — otherwise hovering or focusing
             snaps them back to the stock theme. -->
        <Style Selector="TextBox.d2">
            <Setter Property="Foreground" Value="#E6DCC4" />
            <Setter Property="CaretBrush" Value="#E3C67E" />
            <Setter Property="SelectionBrush" Value="#806B4A2A" />
        </Style>
        <Style Selector="TextBox.d2 /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#050404" />
            <Setter Property="BorderBrush" Value="#6B5430" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.d2:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#0A0807" />
            <Setter Property="BorderBrush" Value="#A8894C" />
        </Style>
        <Style Selector="TextBox.d2:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#050404" />
            <Setter Property="BorderBrush" Value="#E3C67E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.d2:focus">
            <Setter Property="Foreground" Value="#E6DCC4" />
        </Style>
        <Style Selector="TextBox.d2 /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="#7D715C" />
        </Style>

        <Style Selector="Button.d2">
            <Setter Property="FontFamily" Value="Georgia,Times New Roman" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,5" />
        </Style>
        <Style Selector="Button.d2 /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource D2CapBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource D2GoldBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="#D8BE7A" />
        </Style>
        <Style Selector="Button.d2:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource D2StoneBrush}" />
            <Setter Property="BorderBrush" Value="#F0DCA0" />
            <Setter Property="Foreground" Value="#F6E6B4" />
        </Style>
        <Style Selector="Button.d2:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14110E" />
            <Setter Property="Foreground" Value="#B39A5E" />
        </Style>

        <!-- The chat gem sits in its own socket; no button chrome in any state. -->
        <Style Selector="Button.d2gem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.d2gem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.d2gem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <!-- Rows: 0 connect bar, 1 chat. Normal layout puts the input in row 3 and leaves row 2
         empty (Auto collapses it). D2 Style (BotConfig.UseD2ChatLayout) moves the input up into
         row 2, directly under the chat, so one frame can wrap both, and docks the
         Users/Friends/Clan panel in row 3 beneath that instead of in column 2. The chat log spans
         the full width there. Same controls in both layouts, just different Grid coordinates —
         no second copy of anything. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="4" />
            <!-- User-resizable (drag the GridSplitter below) — 180 is just the initial width, not a cap. -->
            <ColumnDefinition Width="180" MinWidth="120" MaxWidth="500" />
        </Grid.ColumnDefinitions>

        <!-- Status / connect bar -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    Spacing="8" Margin="8">
            <Button Content="Connect" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsConnected}" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <CheckBox Content="Debug logging" IsChecked="{Binding DebugMode}" Margin="16,0,0,0" />
        </StackPanel>

        <!-- D2 Style: a near-black ground behind the chat and input (rows 1-2), so the gutter
             between the frame and its contents reads as one dark recessed panel. Declared before
             the chat so it paints underneath. -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="4,0,4,4"
                Background="#050404" IsVisible="{Binding Config.UseD2ChatLayout}" />

        <!-- Chat log: one continuous SelectableTextBlock (built up in code-behind)
             so drag-select and Ctrl+C work across whole lines and multiple
             lines at once, not just within a single colored segment. Classic
             BNCS/Chat-Telnet only — a SupportsMultiChannel bot (SC2/SC:R/WC3:R)
             uses the per-channel sub-tabs below instead. -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Name="ChatScroll" Background="{Binding BackgroundBrush}"
                      Grid.ColumnSpan="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToDoubleConverter.Instance}, ConverterParameter='3|1'}"
                      Margin="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToThicknessConverter.Instance}, ConverterParameter='18,26,18,4|0'}"
                      IsVisible="{Binding !SupportsMultiChannel}">
            <!-- Explicit FontSize/LineHeight (not left to the theme default) so AppendLine's inline
                 icon has a known, controllable line box to center inside — a 20px icon on an
                 unspecified ~13px-line default line height stuck out past the line regardless of
                 BaselineAlignment, just because it was taller than the line itself; that's
                 fixed here (LineHeight 20, icon reduced to 16 in AppendLine) rather than by
                 alignment alone. -->
            <SelectableTextBlock Name="ChatText" Margin="8" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
        </ScrollViewer>

        <!-- Per-channel sub-tabs for a bot that can be joined to several channels at once
             (SC2/SC:R/WC3:R) — each ChannelTabViewModel gets its own chat log (rendered by
             ChannelTabView, resolved via the same global ViewLocator MainWindow.axaml's own
             bot-tab TabControl relies on) and its own roster (see the Users tab below). -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding SupportsMultiChannel}"
              Grid.ColumnSpan="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToDoubleConverter.Instance}, ConverterParameter='3|1'}"
              Margin="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToThicknessConverter.Instance}, ConverterParameter='18,26,18,4|0'}"
              Background="{Binding BackgroundBrush}">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,0">
                <Button Content="+" Padding="8,2" FontSize="12" ToolTip.Tip="Join another channel">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="8" Width="240">
                                <TextBlock Text="Join a public channel" FontWeight="Bold" FontSize="12" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" Name="PublicChannelPicker"
                                              ItemsSource="{Binding AvailablePublicChannels}"
                                              PlaceholderText="Choose a channel..." HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="stimpak:PublicChannel">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="Join"
                                            Command="{Binding JoinPublicChannelCommand}"
                                            CommandParameter="{Binding #PublicChannelPicker.SelectedItem}" />
                                </Grid>
                                <TextBlock Text="Or join a private channel" FontWeight="Bold" FontSize="12" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" Text="{Binding JoinChannelName}" PlaceholderText="Channel name" />
                                    <Button Grid.Column="1" Content="Join" Command="{Binding JoinPrivateChannelCommand}" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <TabControl Grid.Row="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}">
                <TabControl.Styles>
                    <Style Selector="TabItem:selected Border.tabHighlight">
                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                    </Style>
                </TabControl.Styles>
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChannelTabViewModel">
                        <Grid ColumnDefinitions="Auto,Auto">
                            <Border Grid.Column="0" Classes="tabHighlight"
                                    BorderBrush="{Binding $parent[TabControl].((vm:BotTabViewModel)DataContext).HighlightBrush}"
                                    BorderThickness="0" Padding="0,0,4,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Title}" />
                                    <Ellipse Width="6" Height="6" Fill="#2CACE8" VerticalAlignment="Center" IsVisible="{Binding HasUnread}" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Content="×" Padding="4,0" FontSize="11" Background="Transparent" BorderThickness="0"
                                    Click="OnLeaveChannelClick" ToolTip.Tip="Leave this channel" />
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>

        <!-- Column splitter only makes sense while the panel is actually in column 2; D2 Style
             docks it below the chat instead, where a column-resizer would drag nothing. -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" Background="#3A3A3A"
                      HorizontalAlignment="Stretch" ResizeDirection="Columns"
                      IsVisible="{Binding !Config.UseD2ChatLayout}" />

        <!-- D2 Style's frame, modeled on Diablo II's own Battle.net chat screen: a heavy band of
             carved stone trimmed in tarnished gold, square rivet blocks on the corners, studs along
             the long runs, and the channel name on a plate across the top. It wraps the chat AND
             the input row below it (rows 1-2), with a matching stone divider between the two.

             Everything here sits in the gutter the chat and input leave for it (their D2 margins:
             18 on the sides and bottom, 26 at the top for the name plate) — nothing is drawn over
             chat text, and IsHitTestVisible="False" means it never takes a click either. Vector
             shapes rather than bitmaps, so it scales with the window and ships no art. -->
        <Panel Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="4,0,4,4"
               IsVisible="{Binding Config.UseD2ChatLayout}" IsHitTestVisible="False">
            <!-- The band, outside in: black outline, stone with grain over it, a lit bevel edge on
                 the top-left, the gold inlay, then a black shadow line against the contents. -->
            <Border BorderBrush="#000000" BorderThickness="1" />
            <Border Margin="1" BorderBrush="{StaticResource D2StoneBrush}" BorderThickness="10" />
            <Border Margin="1" BorderBrush="{StaticResource D2GrainBrush}" BorderThickness="10" />
            <Border Margin="1" BorderBrush="#6E6352" BorderThickness="1,1,0,0" />
            <Border Margin="10" BorderBrush="{StaticResource D2GoldBrush}" BorderThickness="1" />
            <Border Margin="11" BorderBrush="#000000" BorderThickness="1" />

            <!-- Studs centred on the band: two along the top and bottom runs, one on each side. -->
            <ContentControl Classes="d2stud" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,2,0,0" />
            <ContentControl Classes="d2stud" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,64,0" />
            <ContentControl Classes="d2stud" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="64,0,0,2" />
            <ContentControl Classes="d2stud" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,64,2" />
            <ContentControl Classes="d2stud" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
            <ContentControl Classes="d2stud" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" />

            <ContentControl Classes="d2cap" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <ContentControl Classes="d2cap" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <ContentControl Classes="d2cap" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <ContentControl Classes="d2cap" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

            <!-- Name plate: a stone bar with pointed ends, gold-edged, carrying the channel name in
                 gold serif. Only once there's a channel to name. The ends are filled and stroked
                 as separate shapes so no seam line is drawn where they meet the bar. -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Height="24" ColumnDefinitions="14,Auto,14"
                  IsVisible="{Binding CurrentChannelName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Path Grid.Column="0" Data="M 14.5,0 L 0,12 L 14.5,24 Z" Fill="{StaticResource D2CapBrush}" />
                <Path Grid.Column="0" Data="M 14,0.5 L 0.5,12 L 14,23.5" Stroke="{StaticResource D2GoldBrush}" StrokeThickness="1" />
                <Border Grid.Column="1" Background="{StaticResource D2CapBrush}" BorderBrush="{StaticResource D2GoldBrush}"
                        BorderThickness="0,1" Padding="16,0" MinWidth="150">
                    <TextBlock Text="{Binding CurrentChannelName}" Foreground="#D8BE7A" FontFamily="Georgia,Times New Roman"
                               FontSize="13" FontWeight="Bold" LetterSpacing="1"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Path Grid.Column="2" Data="M -0.5,0 L 14,12 L -0.5,24 Z" Fill="{StaticResource D2CapBrush}" />
                <Path Grid.Column="2" Data="M 0,0.5 L 13.5,12 L 0,23.5" Stroke="{StaticResource D2GoldBrush}" StrokeThickness="1" />
            </Grid>
        </Panel>

        <!-- D2 Style: the stone divider between the chat and the input row, running the full width
             of the frame so it joins the side bands. -->
        <Panel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="4,2,4,0" Height="9" VerticalAlignment="Top"
               IsVisible="{Binding Config.UseD2ChatLayout}" IsHitTestVisible="False">
            <Border Background="{StaticResource D2StoneBrush}" BorderBrush="#000000" BorderThickness="0,1" />
            <Border Background="{StaticResource D2GrainBrush}" Margin="0,1" />
            <Border Height="1" VerticalAlignment="Center" Background="{StaticResource D2GoldBrush}" Margin="12,0" />
            <ContentControl Classes="d2stud" HorizontalAlignment="Center" VerticalAlignment="Center" Width="7" Height="7" />
        </Panel>

        <!-- Users in the current channel, friends list, and (per-game) clan roster. Normally the
             right-hand column; in D2 Style (BotConfig.UseD2ChatLayout) the same control moves to
             the bottom dock (row 3, full width, under the framed chat and input) and gets a height cap so it reads as a strip
             under the chat rather than eating half the tab. The 100000 "cap" in Normal layout is
             just an unreachable number standing in for "no cap" — Grid row sizing handles it
             there. -->
        <TabControl Grid.Row="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToDoubleConverter.Instance}, ConverterParameter='3|1'}"
                    Grid.Column="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToDoubleConverter.Instance}, ConverterParameter='0|2'}"
                    Grid.ColumnSpan="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToDoubleConverter.Instance}, ConverterParameter='3|1'}"
                    MaxHeight="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToDoubleConverter.Instance}, ConverterParameter='190|100000'}"
                    Margin="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToThicknessConverter.Instance}, ConverterParameter='8,2,8,8|0,4,8,8'}"
                    Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="0">
            <TabControl.Styles>
                <!-- Compact header text (this panel is otherwise all small/dense text — Fluent's default TabItem
                     header size looks oversized next to it) and the same colored-underline-on-select pattern as
                     the top-level bot tabs in MainWindow.axaml, so this panel's active-tab indicator is driven by
                     the bot's own customizable Highlight color too, not just Fluent's built-in accent. -->
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="10,6" />
                </Style>
                <Style Selector="TabItem:selected Border.tabHighlight">
                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                </Style>
            </TabControl.Styles>

            <TabItem>
                <TabItem.Header>
                    <Border Classes="tabHighlight" BorderBrush="{Binding HighlightBrush}" BorderThickness="0" Padding="0,0,0,4">
                        <!-- "Users" until a channel's actually joined, then "<channel name> (<count>)" —
                             see BotTabViewModel.UsersTabHeader for how the count stays current for
                             both classic BNCS (ChannelUsers) and SC2/SC:R/WC3:R (SelectedChannel.Users). -->
                        <TextBlock Text="{Binding UsersTabHeader}" />
                    </Border>
                </TabItem.Header>
                <Panel>
                <ListBox ItemsSource="{Binding ChannelUsers}" Background="Transparent" BorderThickness="0" Padding="0,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         IsVisible="{Binding !SupportsMultiChannel}">
                    <!-- D2 Style lays these out left-to-right as a portrait strip along the bottom
                         dock; Normal keeps the usual vertical list. Still a VirtualizingStackPanel
                         either way — this list routinely holds thousands of rows during a mass-join
                         flood, and swapping in a plain StackPanel to get a horizontal flow would
                         have quietly undone all of the load-testing work that made that survivable. -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToOrientationConverter.Instance}}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Icons are unconstrained on Width/Height, only capped at 32x32 by MaxWidth/MaxHeight
                                 with Stretch="Uniform": the default 28x14 set renders at its natural tiny size,
                                 while a swapped-in larger set (e.g. the 64x64 icons classic.battle.net's WC3 pages
                                 served) is shrunk down to fit the cap without distorting its shape. IsLargeIcon
                                 (true once the loaded icon is taller than the classic 14px) switches the row
                                 between a single compact line and username/ping stacked, so a 32px-tall icon isn't
                                 left towering over one thin line of text. -->
                            <!-- Panel (not the Grid directly) is the template root so the context menu
                                 below applies to both arrangements — D2 Style hides the Grid, and a
                                 menu attached to a hidden control would leave the portrait tiles with
                                 no right-click at all. -->
                            <Panel>
                                <Panel.ContextMenu>
                                    <ContextMenu Opened="OnUserContextMenuOpened">
                                        <MenuItem Header="Whisper" Click="OnUserWhisperClick" />
                                        <MenuItem Header="Focus for Reply" Click="OnUserFocusClick"
                                                  ToolTip.Tip="Your next typed line in this channel routes as a whisper to them instead — same as typing /user yourself. Right-click again and choose Clear Focus to go back to normal channel chat." />
                                        <MenuItem Header="Clear Focus" Click="OnUserUnfocusClick" />
                                        <MenuItem Header="Profile Info" Click="OnUserProfileInfoClick" />
                                        <MenuItem Name="UserClanRankMenu" Header="Clan Rank">
                                            <MenuItem Header="View Info" Click="OnUserClanRankClick" />
                                            <Separator />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Squelch" Click="OnUserSquelchClick" />
                                        <MenuItem Header="Add Friend" Click="OnUserAddFriendClick" />
                                        <Separator />
                                        <MenuItem Name="ClassicIconStyleMenuItem" Header="Classic Icon Style"
                                                  ToggleType="CheckBox" Click="OnToggleClassicIconStyleClick"
                                                  ToolTip.Tip="When on, a moderator/Blizzard Rep/etc.'s rank badge replaces their game icon (real classic Battle.net behavior) instead of showing both side by side." />
                                    </ContextMenu>
                                </Panel.ContextMenu>
                            <!-- D2 Style tile: portrait above the name, centered, and nothing else —
                                 no ping, no separate rank badge, matching how Diablo II's own chat
                                 lined characters up along the bottom of the screen. Fixed tile width
                                 so the strip reads as an even lineup instead of jittering with name
                                 length; longer names ellipsize rather than stretching their tile. The
                                 name color follows D2's own sparser rule (see
                                 ChannelUserViewModel.UsernameBrush). -->
                            <StackPanel IsVisible="{Binding UseD2Layout}" Width="88" Margin="2,4"
                                        Orientation="Vertical" Spacing="3" VerticalAlignment="Top">
                                <!-- A Diablo II character gets their real Battle.net portrait tile at
                                     triple size, pixel-doubled rather than smoothed so the 28×14
                                     sprite stays crisp; everyone else keeps their usual icon. The
                                     portrait shows even for a rank-badged user here — the character
                                     is the point of this strip, and the name color already marks
                                     reps. -->
                                <Image Source="{Binding D2PortraitImage}" Width="84" Height="42" Stretch="Fill"
                                       RenderOptions.BitmapInterpolationMode="None" HorizontalAlignment="Center"
                                       IsVisible="{Binding HasD2Portrait}"
                                       ToolTip.Tip="{Binding StatStringDescription}" />
                                <Image Source="{Binding DisplayIconImage}" MaxWidth="44" MaxHeight="44"
                                       Stretch="Uniform" HorizontalAlignment="Center"
                                       IsVisible="{Binding !HasD2Portrait}"
                                       ToolTip.Tip="{Binding StatStringDescription}" />
                                <TextBlock Text="{Binding Username}" Foreground="{Binding UsernameBrush}"
                                           FontSize="11" TextAlignment="Center" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="86"
                                           ToolTip.Tip="{Binding Username}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"
                                  IsVisible="{Binding !UseD2Layout}">
                                <!-- Whisper switches to the global Whispers tab with a thread open for this user
                                     (MainWindowViewModel.FocusWhisperThread) rather than silently setting
                                     whisper-focus with no visible feedback. Profile Info opens a real BNCS 1.0
                                     profile window (SID_READUSERDATA/WRITEUSERDATA — ProfileWindow). Clan Rank is
                                     a submenu: "View Info" (/claninfo) plus one "Set: <rank>" entry per
                                     ClanRankStore rank, built in code-behind (OnUserContextMenuOpened) rather than
                                     bound from XAML — this row's own (ChannelUserViewModel) DataContext binding up
                                     to the enclosing BotTabViewModel via a $parent[views:BotTabView] ancestor-walk
                                     crashed the published build outright (type resolution failed at runtime
                                     despite compiling fine in Debug), and this codebase already has a standing
                                     warning (see OnSendInlineWhisperClick's remarks) that this class of binding
                                     fails silently through TabControls/Popups even when it doesn't crash. Squelch
                                     and Add Friend are real BNCS chat commands, sent straight through. Everything
                                     here shows unconditionally (no SupportsClan gating) since /claninfo and
                                     /clanrank already reply gracefully when clan tracking isn't set up. -->
                                <Image Grid.Column="0" Source="{Binding DisplayIconImage}" MaxWidth="32" MaxHeight="32"
                                       Stretch="Uniform" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding StatStringDescription}" />

                                <!-- Real classic Battle.net behavior: once a StarCraft-family/Warcraft II
                                     user is actually ladder-rated, their win-count badge (ChatIcon.
                                     GetProductIconKey's star/axe/sword plate) is stamped with their
                                     numeric rating instead — see ChannelUserViewModel.LadderScoreText. -->
                                <Border Grid.Column="0" Background="#B0000000" CornerRadius="2" Padding="2,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding ShowLadderScore}">
                                    <TextBlock Text="{Binding LadderScoreText}" FontSize="8" FontWeight="Bold" Foreground="White" />
                                </Border>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="6,0"
                                            VerticalAlignment="Center" IsVisible="{Binding !IsLargeIcon}">
                                    <TextBlock Text="{Binding Username}" Foreground="{Binding UsernameBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Ping}" Foreground="White" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="6,0"
                                            VerticalAlignment="Center" IsVisible="{Binding IsLargeIcon}">
                                    <TextBlock Text="{Binding Username}" Foreground="{Binding UsernameBrush}" />
                                    <TextBlock Text="{Binding Ping}" Foreground="White" Opacity="0.6" FontSize="11" />
                                </StackPanel>

                                <Image Grid.Column="2" Source="{Binding StatusIconImage}" MaxWidth="32" MaxHeight="32"
                                       Stretch="Uniform" VerticalAlignment="Center"
                                       IsVisible="{Binding ShowSeparateStatusIcon}" />
                            </Grid>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- SC2/SC:R/WC3:R: the *currently selected* channel sub-tab's own roster, bound
                     straight to Stimpak's own Person collection (see ChannelTabViewModel) — a
                     much shorter row than classic BNCS's above, since Stimpak's protocol surface
                     doesn't carry per-user operator flags, ping, or a statstring. -->
                <ListBox ItemsSource="{Binding SelectedChannel.Users}" Background="Transparent" BorderThickness="0" Padding="0,4"
                         IsVisible="{Binding SupportsMultiChannel}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="stimpak:Person">
                            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding ., Converter={x:Static conv:PersonDetailsTooltipConverter.Instance}}">
                                <views:PresenceIcon State="{Binding Presence, Converter={x:Static conv:PresenceConverter.Instance}}" />
                                <!-- Person.Name is "&lt;TAG&gt; Username" (tag prefixed) per Stimpak's own
                                     formatting — reordered to a trailing tag instead, per request. -->
                                <TextBlock Text="{Binding ., Converter={x:Static conv:PersonNameWithTrailingClanTagConverter.Instance}}"
                                           Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Panel>
            </TabItem>

            <!-- Hidden entirely for games whose server doesn't push a friends list (Diablo 1, Warcraft II: BNE) -->
            <TabItem IsVisible="{Binding SupportsFriends}">
                <TabItem.Header>
                    <Border Classes="tabHighlight" BorderBrush="{Binding HighlightBrush}" BorderThickness="0" Padding="0,0,0,4">
                        <TextBlock Text="Friends" />
                    </Border>
                </TabItem.Header>
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Refresh" Command="{Binding RefreshFriendsCommand}"
                            HorizontalAlignment="Right" Margin="4" Padding="8,2" FontSize="11" />
                    <ListBox ItemsSource="{Binding Friends}" Background="Transparent" BorderThickness="0" Padding="0,4">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
                                    <!-- Right-click anywhere on a friend's row for a small inline "Whisper" compose
                                         popup — ContextFlyout (not ContextMenu) shows arbitrary content, not just
                                         menu items, so this skips a separate right-click-menu step entirely. Profile
                                         Info opens the real BNCS profile window (ProfileWindow), Clan Rank/Squelch
                                         are real chat commands, and the rank ComboBox at the bottom lets you set
                                         this friend's clan rank directly — its ItemsSource is populated in
                                         code-behind straight from the static ClanRankStore (OnClanRankComboLoaded),
                                         not bound from XAML, for the same reason noted in the classic Users list's
                                         ContextMenu remarks (ancestor-DataContext bindings through Popups/Flyouts
                                         are unreliable in this codebase — one crashed a published build outright). -->
                                    <Grid.ContextFlyout>
                                        <Flyout Placement="Pointer">
                                            <StackPanel Width="220" Spacing="6" Margin="4">
                                                <TextBlock Text="{Binding Account, StringFormat='Whisper {0}'}" FontWeight="Bold" FontSize="12" />
                                                <TextBox PlaceholderText="Message..." Text="{Binding WhisperDraft}" />
                                                <Button Content="Send" HorizontalAlignment="Right" Padding="10,3"
                                                        Click="OnSendInlineWhisperClick" />
                                                <Separator />
                                                <Button Content="Profile Info" HorizontalAlignment="Stretch" Padding="10,3"
                                                        Click="OnFriendProfileInfoClick" />
                                                <Button Content="Clan Rank" HorizontalAlignment="Stretch" Padding="10,3"
                                                        Click="OnFriendClanRankClick" />
                                                <Button Content="Squelch" HorizontalAlignment="Stretch" Padding="10,3"
                                                        Click="OnFriendSquelchClick" />
                                                <Separator />
                                                <TextBlock Text="Set clan rank:" FontSize="11" Opacity="0.7" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" Loaded="OnClanRankComboLoaded" />
                                                    <Button Grid.Column="1" Content="Set" Click="OnFriendSetClanRankClick" />
                                                </Grid>
                                            </StackPanel>
                                        </Flyout>
                                    </Grid.ContextFlyout>
                                    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Source="{Binding ProductIconImage}"
                                           MaxWidth="32" MaxHeight="32" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           IsVisible="{Binding ProductIconImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <views:PresenceIcon Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,6,0"
                                                         State="{Binding PresenceState}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Account}" Foreground="White" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StatusText}" Foreground="White" Opacity="0.6" FontSize="10" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- The bot's own clan-management system (roster/rank/alias/trivia-score), not Battle.net's native clan protocol.
                 Only shown once this bot has ClanFeatureEnabled turned on (Config window) AND the shared roster has at
                 least one member — see BotTabViewModel.SupportsClan. -->
            <TabItem IsVisible="{Binding SupportsClan}">
                <TabItem.Header>
                    <Border Classes="tabHighlight" BorderBrush="{Binding HighlightBrush}" BorderThickness="0" Padding="0,0,0,4">
                        <TextBlock Text="Clan" />
                    </Border>
                </TabItem.Header>
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Manage Members..." Click="OnManageClanClick"
                            HorizontalAlignment="Right" Margin="4" Padding="8,2" FontSize="11" />
                    <ListBox ItemsSource="{Binding ClanRoster}" Background="Transparent" BorderThickness="0" Padding="0,4">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClanMemberViewModel">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" Foreground="White" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TriviaScore, StringFormat='{}{0} pts'}"
                                               Foreground="White" Opacity="0.7" FontSize="10" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Foreground="White" Opacity="0.6" FontSize="10">
                                        <Run Text="{Binding Rank}" /><Run Text=" · " /><Run Text="{Binding LastSeenText}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

        </TabControl>

        <!-- Input. Row 3 in Normal layout; D2 Style lifts it to row 2, inside the frame directly
             under the chat, with the frame's divider above it (hence the taller top margin) and
             the chat gem set in a socket at the end of the row. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto"
              Grid.Row="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToDoubleConverter.Instance}, ConverterParameter='2|3'}"
              Margin="{Binding Config.UseD2ChatLayout, Converter={x:Static conv:BoolToThicknessConverter.Instance}, ConverterParameter='18,17,18,18|8'}">
            <!-- Tinted with the scheme's Highlight color, thickening on focus, so it's obvious this box has focus before you type. -->
            <TextBox Grid.Column="0" Name="InputBox" Text="{Binding InputText}" PlaceholderText="Type a message or /command..."
                     Classes="chatInput" Classes.d2="{Binding Config.UseD2ChatLayout}"
                     BorderBrush="{Binding HighlightBrush}" BorderThickness="1">
                <TextBox.Styles>
                    <Style Selector="TextBox.chatInput:focus">
                        <Setter Property="BorderThickness" Value="2" />
                    </Style>
                </TextBox.Styles>
            </TextBox>
            <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0"
                    Classes.d2="{Binding Config.UseD2ChatLayout}" VerticalAlignment="Stretch" />

            <!-- Diablo II's chat gem, set in a gold-rimmed socket beside Send. Click toggles blue
                 (activated) / red (deactivated) and prints one line into this bot's own chat log —
                 local flavor only, nothing goes to Battle.net. A soft glow of its own color sits
                 behind the stone while it's lit. Part of the input row's own layout, not an
                 overlay, so it can't cover anything. -->
            <Button Grid.Column="2" Classes="d2gem" IsVisible="{Binding Config.UseD2ChatLayout}"
                    Command="{Binding ToggleChatGemCommand}" ToolTip.Tip="{Binding ChatGemTooltip}"
                    Margin="6,0,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" Cursor="Hand">
                <Panel Width="42" Height="32">
                    <Ellipse Width="30" Height="22" Fill="{Binding ChatGemBrush}" Opacity="0.55"
                             IsVisible="{Binding ChatGemActive}">
                        <Ellipse.Effect>
                            <BlurEffect Radius="8" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="38" Height="28" Fill="#0A0807" Stroke="#000000" StrokeThickness="1" />
                    <Ellipse Width="36" Height="26" Stroke="{StaticResource D2GoldBrush}" StrokeThickness="2" />
                    <Ellipse Width="29" Height="20" Stroke="#3A3226" StrokeThickness="1" />
                    <!-- Faceted stone: a diamond in the palette's blue/red with a lighter sliver
                         for the upper facet, so it follows the bot's color scheme. -->
                    <Panel Width="22" Height="14">
                        <Path Data="M 11,0 L 22,7 L 11,14 L 0,7 Z" Fill="{Binding ChatGemBrush}"
                              Stroke="#50000000" StrokeThickness="1" />
                        <Path Data="M 11,2 L 17,6.5 L 11,5 L 5,6.5 Z" Fill="#70FFFFFF" />
                    </Panel>
                </Panel>
            </Button>
        </Grid>

    </Grid>
</UserControl>
