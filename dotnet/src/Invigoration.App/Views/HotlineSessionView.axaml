<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Invigoration.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Invigoration.App.Views.HotlineSessionView"
             x:DataType="vm:HotlineSessionViewModel">

    <Grid ColumnDefinitions="*,232" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Who you are on this server, in the space the server-name bar used to take (the tab
             already says which server this is). The preview is drawn exactly like a Users-list
             row — same panel color, icon behind, name over it at the same offset and in the same
             black-or-white — so it shows how you'll actually appear. Nothing is sent until Apply. -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="8,5">
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="5">
                <Border Background="#D8D8D8" Width="232" Height="18" ClipToBounds="True" VerticalAlignment="Center"
                        ToolTip.Tip="How you'll appear in the user list once applied">
                    <Grid>
                        <Image Source="{Binding EditIconPreview}" Height="18" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EditNickname}" Foreground="{Binding EditNameBrush}" Margin="{Binding NameMargin}" FontWeight="Bold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <TextBox Text="{Binding EditNickname}" Width="150" MaxLength="31" VerticalAlignment="Center"
                         PlaceholderText="Name" ToolTip.Tip="Your name on this server" />
                <NumericUpDown Value="{Binding EditIconId}" Minimum="0" Maximum="65535" FormatString="0" Width="135" VerticalAlignment="Center"
                               ToolTip.Tip="Icon number" />
                <Button Content="Choose..." Click="OnChooseIconClick" VerticalAlignment="Center"
                        ToolTip.Tip="Browse every icon on hlwiki.com's ik0ns page" />
                <Button Content="Apply" Command="{Binding ApplyIdentityCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Change your name and icon on this server now (saved to the server's profile too)" />
            </WrapPanel>
        </Border>

        <!-- Never auto-sent (see HotlineTransactionClient.AutoAcceptAgreement's remarks) — the
             user explicitly asked for an "Agreement" surface that "can be closed with an x" and
             "should pop up if its prompted", not a silent auto-accept. This banner is a stand-in
             for the fuller per-server Chat/Files/News/Agreement tab layout the user described;
             upgrading to that is a follow-up, not done here. -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#2A2410" BorderBrush="#5A4E1A" BorderThickness="0,0,0,1"
                Padding="10,8" IsVisible="{Binding PendingAgreementText, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="x" Padding="8,2" Command="{Binding DismissAgreementCommand}" />
                <Button DockPanel.Dock="Right" Content="Accept" Margin="0,0,8,0" Command="{Binding AcceptAgreementCommand}" />
                <ScrollViewer MaxHeight="120">
                    <TextBlock Text="{Binding PendingAgreementText}" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Chat / Files / News for this one server. Files and News don't ask the server anything
             until their tab is first opened (HotlineSessionViewModel.OnSelectedSectionIndexChanged) —
             most sessions are opened to chat, and a server with a big file tree shouldn't be
             walked just in case. -->
        <TabControl Grid.Row="2" Grid.Column="0" SelectedIndex="{Binding SelectedSectionIndex}" Padding="0">
            <TabItem Header="Chat">

        <!-- SelectableTextBlock (not plain TextBlock) so an individual line's text can be
             click-dragged and copied directly — a ListBox only supports item selection, not text
             selection, which is what made "Copy Log" above necessary in the first place. -->
        <ListBox Name="MessagesList" ItemsSource="{Binding Messages}" Background="Transparent" Padding="4">
            <!-- Same fix as the Users list — ListBoxItem's default theme padding/min-height was
                 adding visible gaps between every chat line. -->
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HotlineChatLine">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- A banner line carries the server's own image, shown once on login and
                             then scrolling away like any other line. Left-aligned at its natural
                             size, capped so a large one can't shove the chat log around. -->
                        <Image Grid.Column="0" Grid.ColumnSpan="2" Source="{Binding Banner}"
                               MaxHeight="90" HorizontalAlignment="Left" Stretch="Uniform"
                               StretchDirection="DownOnly" Margin="0,4"
                               IsVisible="{Binding HasBanner}" />
                        <Image Grid.Column="0" Source="{Binding UsernameIcon}" Height="18" Width="18" Margin="0,0,4,0"
                               VerticalAlignment="Top" IsVisible="{Binding UsernameIcon, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                        <SelectableTextBlock Grid.Column="1" TextWrapping="Wrap" IsVisible="{Binding !HasBanner}">
                            <Run Text="{Binding Username}" Foreground="{Binding UsernameColor}" FontWeight="Bold" />
                            <Run Text="{Binding Text}" />
                        </SelectableTextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
            </TabItem>

            <TabItem Header="Files">
                <Grid RowDefinitions="Auto,*,Auto" DataContext="{Binding Files}" x:CompileBindings="False">
                    <DockPanel Grid.Row="0" Margin="6">
                        <Button DockPanel.Dock="Left" Content="↑" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}"
                                ToolTip.Tip="Up one folder" Padding="8,3" />
                        <Button DockPanel.Dock="Right" Content="New Folder..." Command="{Binding StartNewFolderCommand}"
                                IsVisible="{Binding CanCreateFolder}" Padding="8,3" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Upload Folder..." Command="{Binding UploadFolderCommand}"
                                IsVisible="{Binding CanUpload}" Padding="8,3" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Upload..." Command="{Binding UploadCommand}"
                                IsVisible="{Binding CanUpload}" Padding="8,3" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Padding="8,3" />
                        <TextBlock Text="{Binding PathText}" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="Nothing to show yet — press Refresh." Opacity="0.5" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding ShowEmptyHint}" />
                    <!-- Double-click activates a row: a folder opens, anything else downloads.
                         Handled in code-behind (OnFilesDoubleTapped) because the double-click
                         lands on whichever element inside the row was under the pointer, not on
                         the row itself. -->
                    <ListBox Grid.Row="1" Name="FilesList" ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}" Background="Transparent"
                             DoubleTapped="OnFilesDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- The menu binds to the row's own commands: a context menu opens in
                                     its own popup tree, where a binding that walks up to the ListBox
                                     resolves to nothing. It also acts on the row it was opened over
                                     rather than on the selection, since right-clicking need not
                                     select. Stretched horizontally so the whole row is a target, not
                                     just the text. -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open" Command="{Binding ActivateCommand}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="{Binding DownloadLabel}" Command="{Binding DownloadCommand}" />
                                            <Separator IsVisible="{Binding CanRename}" />
                                            <MenuItem Header="Rename..." Command="{Binding RenameCommand}" IsVisible="{Binding CanRename}" />
                                            <MenuItem Header="Delete..." Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" FontSize="10" Opacity="0.6"
                                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="2" Width="90" Height="6" Value="{Binding DownloadProgress}"
                                                 VerticalAlignment="Center" IsVisible="{Binding DownloadProgress}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- One strip serving rename, new folder, and the delete confirmation. Inline
                         rather than a modal: it keeps what's being acted on visible behind it, and
                         a delete confirmation that names the thing is the whole point. -->
                    <Grid Grid.Row="2" Margin="6" RowDefinitions="Auto,Auto" IsVisible="{Binding IsPrompting}">
                        <TextBlock Grid.Row="0" Text="{Binding PromptHeading}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />
                        <DockPanel Grid.Row="1">
                            <Button DockPanel.Dock="Right" Content="{Binding PromptAction}" Command="{Binding SubmitPromptCommand}"
                                    Padding="10,3" Margin="6,0,0,0" IsDefault="True" />
                            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelPromptCommand}" Padding="10,3" />
                            <TextBox Text="{Binding PromptText}" IsVisible="{Binding NeedsPromptText}" />
                        </DockPanel>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="6" IsVisible="{Binding !IsPrompting}">
                        <!-- Works for a folder too: that downloads the whole thing, recreating its
                             structure under a directory you pick. Double-clicking a folder still
                             browses into it. -->
                        <Button DockPanel.Dock="Right" Content="Download" Command="{Binding DownloadCommand}"
                                CommandParameter="{Binding SelectedEntry}" Padding="10,3"
                                ToolTip.Tip="Download the selected file, or the whole selected folder"
                                IsEnabled="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenCommand}"
                                CommandParameter="{Binding SelectedEntry}" Padding="10,3" Margin="0,0,6,0"
                                ToolTip.Tip="Browse into the selected folder"
                                IsVisible="{Binding SelectedEntry.IsFolder, FallbackValue=False}" />
                        <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" FontSize="11" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="News">
                <Grid RowDefinitions="Auto,*,Auto" DataContext="{Binding News}" x:CompileBindings="False">
                    <DockPanel Grid.Row="0" Margin="6">
                        <Button DockPanel.Dock="Left" Content="↑" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}"
                                ToolTip.Tip="Up one level" Padding="8,3" />
                        <Button DockPanel.Dock="Right" Content="Post..." Command="{Binding StartPostCommand}"
                                IsVisible="{Binding CanPost}" Padding="8,3" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Padding="8,3" />
                        <TextBlock Text="{Binding PathText}" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Grid Grid.Row="1" RowDefinitions="*,Auto,*">
                        <TextBlock Grid.Row="0" Text="Nothing to show yet — press Refresh." Opacity="0.5" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowEmptyHint}" />

                        <!-- The server's flat news document — the original 1.x form, and where the
                             real news still lives on most classic servers. Shown first, with the
                             category tree (usually near-empty) underneath. -->
                        <ScrollViewer Grid.Row="0" IsVisible="{Binding HasFlatNews}">
                            <SelectableTextBlock Text="{Binding FlatNews}" TextWrapping="Wrap" Margin="8"
                                                 FontFamily="{OnPlatform Default=monospace, macOS=Menlo}" FontSize="12" />
                        </ScrollViewer>

                        <!-- Categories while browsing the tree; the article list once inside one. -->
                        <ListBox Grid.Row="2" ItemsSource="{Binding Categories}" Background="Transparent"
                                 IsVisible="{Binding !IsInCategory}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Grid.Row="2" ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticle}"
                                 Background="Transparent" IsVisible="{Binding IsInCategory}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{Binding Indent}">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Byline}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#3A3A3A" />

                        <Border Grid.Row="2" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="8"
                                ZIndex="1" Background="#1B1B1B"
                                IsVisible="{Binding HasOpenArticle}">
                            <DockPanel>
                                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="Reply"
                                        Command="{Binding StartReplyCommand}" IsVisible="{Binding CanPost}" Padding="8,3" />
                                <ScrollViewer>
                                    <SelectableTextBlock Text="{Binding ArticleBody}" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Composer, shown in place of the footer while writing a post or a reply. -->
                    <Grid Grid.Row="2" Margin="6" RowDefinitions="Auto,Auto,Auto,Auto" IsVisible="{Binding IsComposing}">
                        <TextBlock Grid.Row="0" Text="{Binding ComposeHeading}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Grid.Row="1" PlaceholderText="Subject" Text="{Binding ComposeTitle}" />
                        <TextBox Grid.Row="2" PlaceholderText="Write your post..." Text="{Binding ComposeBody}"
                                 AcceptsReturn="True" Height="90" TextWrapping="Wrap" Margin="0,6" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Cancel" Command="{Binding CancelPostCommand}" Padding="10,3" />
                            <Button Content="Post" Command="{Binding SubmitPostCommand}" Padding="10,3" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Margin="6" Text="{Binding StatusMessage}" Opacity="0.7" FontSize="11"
                               TextWrapping="Wrap" IsVisible="{Binding !IsComposing}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Lighter background (not this app's usual dark theme) — real Hotline clients render
             names in black by default (admin/mod ranks get their own colors, a follow-up once
             UserFlags' rank bits are confirmed), and black-on-dark is unreadable. -->
        <Border Grid.Row="2" Grid.Column="1" Background="#D8D8D8" BorderBrush="#3A3A3A" BorderThickness="1,0,0,0">
            <Grid Margin="6" RowDefinitions="Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Text="Users" FontWeight="Bold" Foreground="Black" Opacity="0.7" Margin="0,0,0,4" />
                <!-- Real Hotline client convention, per the user's own spec: the icon is a
                     background layer for the whole row, not something the name lays out around —
                     the name always sits at a fixed 33px left offset (HotlineIconLoader.NameOffset — past the small emblem most banners carry at their left) regardless of icon width, so
                     a wider icon just extends further behind the text instead of pushing it over.
                     Rows are exactly 18px with zero padding/spacing so icons sit flush against
                     each other — ListBoxItem's own default theme padding/min-height would
                     otherwise add gaps between rows, so both are zeroed out below. -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Users}" Background="Transparent" Padding="0">
                    <!-- This is a display list, not something clickable yet — a stray click was
                         leaving a row stuck with the theme's selected-row highlight, which reads
                         oddly against the flat panel background. Suppressed until right-click
                         actions (per-user context menu) give selection an actual purpose. -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HotlineUserRowViewModel">
                            <Grid Height="18">
                                <Grid.ContextMenu>
                                    <!-- A preset palette rather than a full color-picker popup — simpler and more reliable inside a menu, and matches the classic IRC-client "highlight this person" idiom this was modeled on. -->
                                    <ContextMenu>
                                        <MenuItem Header="Send Private Message..." Command="{Binding SendPrivateMessageCommand}" />
                                        <Separator />
                                        <MenuItem Header="Highlight Color">
                                            <MenuItem Header="Red" Command="{Binding SetHighlightColorCommand}" CommandParameter="#FF6B6B">
                                                <MenuItem.Icon><Border Background="#FF6B6B" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Orange" Command="{Binding SetHighlightColorCommand}" CommandParameter="#FFA500">
                                                <MenuItem.Icon><Border Background="#FFA500" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Yellow" Command="{Binding SetHighlightColorCommand}" CommandParameter="#D4AC00">
                                                <MenuItem.Icon><Border Background="#D4AC00" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Green" Command="{Binding SetHighlightColorCommand}" CommandParameter="#2E9E4C">
                                                <MenuItem.Icon><Border Background="#2E9E4C" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Cyan" Command="{Binding SetHighlightColorCommand}" CommandParameter="#1E9E96">
                                                <MenuItem.Icon><Border Background="#1E9E96" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Blue" Command="{Binding SetHighlightColorCommand}" CommandParameter="#3A7BFF">
                                                <MenuItem.Icon><Border Background="#3A7BFF" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Purple" Command="{Binding SetHighlightColorCommand}" CommandParameter="#8B3AFF">
                                                <MenuItem.Icon><Border Background="#8B3AFF" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Pink" Command="{Binding SetHighlightColorCommand}" CommandParameter="#E0479E">
                                                <MenuItem.Icon><Border Background="#E0479E" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Clear Highlight" Command="{Binding ClearHighlightColorCommand}" />
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Image Source="{Binding Icon}" Height="18" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Foreground="{Binding DisplayBrush}" Margin="33,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Bold" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Discord users seen through this server's relay, kept visually separate from
                     real connections (per explicit request) — see
                     HotlineTrackerConfig.DiscordRelayUsername's remarks. Bounded height + its own
                     scroll rather than sharing the Users list's flexible space, since this list can
                     otherwise grow to dominate the panel on a busy relayed channel. -->
                <TextBlock Grid.Row="2" Text="Discord" FontWeight="Bold" Foreground="Black" Opacity="0.7" Margin="0,8,0,4" />
                <ListBox Grid.Row="3" ItemsSource="{Binding DiscordUsers}" Background="Transparent" Padding="0" MaxHeight="150">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HotlineGhostUserViewModel">
                            <Grid Height="18">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Highlight Color">
                                            <MenuItem Header="Red" Command="{Binding SetHighlightColorCommand}" CommandParameter="#FF6B6B">
                                                <MenuItem.Icon><Border Background="#FF6B6B" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Orange" Command="{Binding SetHighlightColorCommand}" CommandParameter="#FFA500">
                                                <MenuItem.Icon><Border Background="#FFA500" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Yellow" Command="{Binding SetHighlightColorCommand}" CommandParameter="#D4AC00">
                                                <MenuItem.Icon><Border Background="#D4AC00" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Green" Command="{Binding SetHighlightColorCommand}" CommandParameter="#2E9E4C">
                                                <MenuItem.Icon><Border Background="#2E9E4C" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Cyan" Command="{Binding SetHighlightColorCommand}" CommandParameter="#1E9E96">
                                                <MenuItem.Icon><Border Background="#1E9E96" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Blue" Command="{Binding SetHighlightColorCommand}" CommandParameter="#3A7BFF">
                                                <MenuItem.Icon><Border Background="#3A7BFF" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Purple" Command="{Binding SetHighlightColorCommand}" CommandParameter="#8B3AFF">
                                                <MenuItem.Icon><Border Background="#8B3AFF" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Pink" Command="{Binding SetHighlightColorCommand}" CommandParameter="#E0479E">
                                                <MenuItem.Icon><Border Background="#E0479E" Width="12" Height="12" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Clear Highlight" Command="{Binding ClearHighlightColorCommand}" />
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Image Source="{Binding Icon}" Height="18" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Foreground="{Binding DisplayBrush}" Margin="20,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Bold" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Moved down here from the old top bar, which now holds your name and icon. -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,8,0,0">
                    <!-- The theme's own button is pale-on-pale against this light panel. -->
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Background" Value="#3A3A3A" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#505050" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="Copy Log" Click="OnCopyLogClick" IsVisible="{Binding ShowCopyLogButton}"
                            ToolTip.Tip="Copies the whole chat/debug log to the clipboard" />
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat input belongs to chat: hidden while browsing Files or News, where a typed line
             would otherwise go silently to the channel. -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="8"
              IsVisible="{Binding IsChatSection}">
            <TextBox Grid.Column="0" Name="InputBox" Text="{Binding InputText}" PlaceholderText="Type a message..."
                     IsEnabled="{Binding IsConnected}" />
            <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0" IsEnabled="{Binding IsConnected}" />
        </Grid>
    </Grid>
</UserControl>
