<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Invigoration.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="720"
        x:Class="Invigoration.App.Views.BotAppearanceWindow"
        x:DataType="vm:ConfigViewModel"
        Width="620" Height="760"
        Title="Bot Appearance">

    <Window.Styles>
        <Style Selector="TextBlock.step">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Image Grid.Column="0" Source="{Binding ProductIconImage}" Width="28" Height="28" Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Config.DisplayName}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Appearance" FontSize="11" Opacity="0.6" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Click="OnCancelClick" />
                    <Button Content="Save" Click="OnSaveClick" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16" Spacing="8">

                <TextBlock Classes="step" Text="Theme" Margin="0" />
                <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="hint"
                           Text="How this bot's tab looks. Default: chat on the left, the Users/Friends/Clan panel on the right. Diablo II frames the chat in carved stone and docks the users as characters along the bottom. StarCraft, Warcraft II and Warcraft III frame the chat in their own style. Picking a theme also switches the chat colors below to match. Make your own in Customize → Manage Themes." />

                <TextBlock Classes="step" Text="Chat colors" />
                <ComboBox ItemsSource="{Binding AvailableColorSchemes}"
                          SelectedValue="{Binding ColorScheme}"
                          SelectedValueBinding="{Binding Value}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ItemsControl ItemsSource="{Binding PaletteSwatches}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,6">
                                <Border Background="{Binding Brush}" Width="14" Height="14" CornerRadius="3"
                                        BorderBrush="#3A3A3A" BorderThickness="1" />
                                <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.85" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsVisible="{Binding IsCustomScheme}" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding LibrarySchemes}"
                                  SelectedItem="{Binding SelectedLibraryScheme}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Pick a saved scheme...">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="Load" Command="{Binding LoadLibrarySchemeCommand}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Create or edit schemes in Customize → Manage Colors." />
                </StackPanel>

                <TextBlock Classes="step" Text="Icons" />
                <ComboBox ItemsSource="{Binding AvailableIconSets}" SelectedItem="{Binding IconSetName}" HorizontalAlignment="Stretch" />
                <TextBlock Classes="hint" Text="Create or edit icon sets in Customize → Manage Icons." />
                <CheckBox Content="Show game icons next to names in chat" IsChecked="{Binding Config.ShowUserIconsInChat}" Margin="0,4,0,0" />

                <TextBlock Classes="step" Text="Tab" />
                <TextBlock Classes="hint"
                           Text="Tab group and group icon moved to the bot's own settings (Bot → Edit Settings → Tab group) — grouping decides how bots are organized rather than how one looks, and it was too easy to miss in here." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
