<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Invigoration.App.ViewModels"
        xmlns:views="using:Invigoration.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="Invigoration.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/flag.ico"
        Width="1000" Height="650"
        Title="Invigoration">

    <!-- The macOS menu bar. Two rules from how Avalonia's native menu works (checked against its
         12.1.1 source): an item with neither a Command nor a Click handler is always greyed out,
         and clicking a checkbox/radio item never flips its checkmark — so every toggle here is a
         Command with a one-way IsChecked the view model keeps current, never a TwoWay binding on
         its own. The in-window Menu below mirrors this one for Windows/Linux. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Manage Battle.net Profiles..." Click="OnManageBattlenetProfilesNativeClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Add Hotline Tracker" Click="OnAddHotlineTrackerNativeClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Open Config Folder..." Click="OnOpenConfigFolderNativeClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Click="OnExitNativeClick" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <!-- Everything for the selected bot (MainWindowViewModel's Bot menu section), headed by
                 that bot's name since from a non-bot tab it's the last bot that was showing. -->
            <NativeMenuItem Header="Bot">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding SelectedBotMenuLabel}" IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Connect" Command="{Binding ConnectSelectedBotCommand}" />
                        <NativeMenuItem Header="Disconnect" Command="{Binding DisconnectSelectedBotCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Edit Settings..." Click="OnEditBotNativeClick" IsEnabled="{Binding HasSelectedBot}" />
                        <NativeMenuItem Header="Appearance..." Click="OnBotAppearanceNativeClick" IsEnabled="{Binding HasSelectedBot}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Joins and Leaves">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Show All" ToggleType="Radio"
                                                    IsChecked="{Binding SelectedBotShowsAllJoinLeave, Mode=OneWay}"
                                                    Command="{Binding ShowAllJoinLeaveCommand}" />
                                    <NativeMenuItem Header="Hide Spam" ToggleType="Radio"
                                                    IsChecked="{Binding SelectedBotHidesJoinLeaveSpam, Mode=OneWay}"
                                                    Command="{Binding HideJoinLeaveSpamCommand}" />
                                    <NativeMenuItem Header="Hide All" ToggleType="Radio"
                                                    IsChecked="{Binding SelectedBotHidesAllJoinLeave, Mode=OneWay}"
                                                    Command="{Binding HideAllJoinLeaveCommand}" />
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <!-- Filled in code (MainWindow.RebuildIconSetMenus): the sets change as they're saved and deleted. -->
                        <NativeMenuItem Header="Icon Set" IsEnabled="{Binding HasSelectedBot}">
                            <NativeMenuItem.Menu>
                                <NativeMenu />
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Show Icons in Chat" ToggleType="CheckBox"
                                        IsChecked="{Binding SelectedBotShowsUserIconsInChat, Mode=OneWay}"
                                        Command="{Binding ToggleSelectedBotUserIconsInChatCommand}" />
                        <NativeMenuItem Header="Debug Logging" ToggleType="CheckBox"
                                        IsChecked="{Binding SelectedBotDebugMode, Mode=OneWay}"
                                        Command="{Binding ToggleSelectedBotDebugModeCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Normalize Password..." Click="OnNormalizePasswordNativeClick" IsEnabled="{Binding HasSelectedBot}" />
                        <NativeMenuItem Header="Remove Bot..." Click="OnRemoveBotNativeClick" IsEnabled="{Binding HasSelectedBot}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Add Bot..." Click="OnAddBotNativeClick" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Clan" IsVisible="{Binding AnyBotHasClanEnabled}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Manage Members..." Click="OnClanMembersNativeClick" />
                        <NativeMenuItem Header="Manage Ranks..." Click="OnClanRanksNativeClick" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Customize">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Manage Icons..." Click="OnManageIconsNativeClick" />
                        <NativeMenuItem Header="Manage Colors..." Click="OnManageColorsNativeClick" />
                        <NativeMenuItem Header="Manage Themes..." Click="OnManageThemesNativeClick" />
                        <NativeMenuItem Header="Download Diablo II Gear Data..." Click="OnDownloadD2EquipmentNativeClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Music Player" ToggleType="CheckBox" IsChecked="{Binding IsMusicEnabled, Mode=OneWay}"
                                        Command="{Binding ToggleMusicEnabledCommand}" />
                        <NativeMenuItem Header="Music Bar (bottom)" ToggleType="CheckBox" IsChecked="{Binding IsMusicBarEnabled, Mode=OneWay}"
                                        Command="{Binding ToggleMusicBarEnabledCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Tell Me About New Versions" ToggleType="CheckBox" IsChecked="{Binding IsUpdateCheckEnabled, Mode=OneWay}"
                                        Command="{Binding ToggleUpdateCheckEnabledCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Help">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="About" Click="OnAboutNativeClick" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top" IsVisible="{OnPlatform Default=True, macOS=False}">
            <MenuItem Header="_File">
                <MenuItem Header="Manage _Battle.net Profiles..." Click="OnManageBattlenetProfilesClick" />
                <Separator />
                <MenuItem Header="Add _Hotline Tracker" Click="OnAddHotlineTrackerClick" />
                <Separator />
                <MenuItem Header="Open Config _Folder..." Click="OnOpenConfigFolderClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Bot">
                <MenuItem Header="{Binding SelectedBotMenuLabel}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="_Connect" Command="{Binding ConnectSelectedBotCommand}" />
                <MenuItem Header="_Disconnect" Command="{Binding DisconnectSelectedBotCommand}" />
                <Separator />
                <MenuItem Header="_Edit Settings..." Click="OnEditBotClick" IsEnabled="{Binding HasSelectedBot}" />
                <MenuItem Header="_Appearance..." Click="OnBotAppearanceClick" IsEnabled="{Binding HasSelectedBot}" />
                <Separator />
                <MenuItem Header="_Joins and Leaves">
                    <MenuItem Header="_Show All" ToggleType="Radio" GroupName="JoinLeaveDisplay"
                              IsChecked="{Binding SelectedBotShowsAllJoinLeave, Mode=OneWay}"
                              Command="{Binding ShowAllJoinLeaveCommand}" />
                    <MenuItem Header="Hide S_pam" ToggleType="Radio" GroupName="JoinLeaveDisplay"
                              IsChecked="{Binding SelectedBotHidesJoinLeaveSpam, Mode=OneWay}"
                              Command="{Binding HideJoinLeaveSpamCommand}" />
                    <MenuItem Header="_Hide All" ToggleType="Radio" GroupName="JoinLeaveDisplay"
                              IsChecked="{Binding SelectedBotHidesAllJoinLeave, Mode=OneWay}"
                              Command="{Binding HideAllJoinLeaveCommand}" />
                </MenuItem>
                <MenuItem x:Name="IconSetMenu" Header="_Icon Set" IsEnabled="{Binding HasSelectedBot}" />
                <MenuItem Header="_Show Icons in Chat" ToggleType="CheckBox"
                          IsChecked="{Binding SelectedBotShowsUserIconsInChat, Mode=OneWay}"
                          Command="{Binding ToggleSelectedBotUserIconsInChatCommand}" />
                <MenuItem Header="Debug _Logging" ToggleType="CheckBox"
                          IsChecked="{Binding SelectedBotDebugMode, Mode=OneWay}"
                          Command="{Binding ToggleSelectedBotDebugModeCommand}" />
                <Separator />
                <MenuItem Header="_Normalize Password..." Click="OnNormalizePasswordClick" IsEnabled="{Binding HasSelectedBot}" />
                <MenuItem Header="_Remove Bot..." Click="OnRemoveBotClick" IsEnabled="{Binding HasSelectedBot}" />
                <Separator />
                <MenuItem Header="Add _Bot..." Click="OnAddBotClick" />
            </MenuItem>
            <MenuItem Header="_Clan" IsVisible="{Binding AnyBotHasClanEnabled}">
                <MenuItem Header="_Manage Members..." Click="OnClanMembersClick" />
                <MenuItem Header="Manage _Ranks..." Click="OnClanRanksClick" />
            </MenuItem>
            <MenuItem Header="_Customize">
                <MenuItem Header="Manage _Icons..." Click="OnManageIconsClick" />
                <MenuItem Header="Manage _Colors..." Click="OnManageColorsClick" />
                <MenuItem Header="Manage _Themes..." Click="OnManageThemesClick" />
                <MenuItem Header="Download Diablo II _Gear Data..." Click="OnDownloadD2EquipmentClick" />
                <Separator />
                <MenuItem Header="Music Player" ToggleType="CheckBox" IsChecked="{Binding IsMusicEnabled, Mode=OneWay}"
                          Command="{Binding ToggleMusicEnabledCommand}" />
                <MenuItem Header="Music Bar (bottom)" ToggleType="CheckBox" IsChecked="{Binding IsMusicBarEnabled, Mode=OneWay}"
                          Command="{Binding ToggleMusicBarEnabledCommand}" />
                <Separator />
                <MenuItem Header="Tell Me About New _Versions" ToggleType="CheckBox" IsChecked="{Binding IsUpdateCheckEnabled, Mode=OneWay}"
                          Command="{Binding ToggleUpdateCheckEnabledCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- Optional persistent playback bar, docked below everything else regardless of which
             top-level tab is showing — the whole point (explicit request, 2026-08-24) is
             controlling Spotify without needing to switch to the Music tab. Off by default
             (IsMusicBarEnabled); driven by MusicBarViewModel, refreshed by the same timer that
             already polls MusicPlayerRegistry.Controller for the title bar (see
             MainWindow.axaml.cs's UpdateTitleAsync). x:CompileBindings="False" here for the same
             reason the TabStrip header template above needs it: the inner DataContext (MusicBar)
             is a different runtime type than this Window's own x:DataType. -->
        <Border DockPanel.Dock="Bottom" Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0"
                Padding="10,6" IsVisible="{Binding IsMusicBarEnabled}">
            <Grid DataContext="{Binding MusicBar}" x:CompileBindings="False"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <Image Grid.Column="0" Source="{Binding ServiceIcon}" MaxWidth="24" MaxHeight="24"
                       Stretch="Uniform" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" IsVisible="{Binding HasNowPlaying}" />
                    <TextBlock Text="{Binding Artist}" Foreground="White" Opacity="0.6" FontSize="11"
                               TextTrimming="CharacterEllipsis" IsVisible="{Binding HasNowPlaying}" />
                    <TextBlock Text="Nothing playing" Foreground="White" Opacity="0.5" FontSize="11"
                               IsVisible="{Binding !HasNowPlaying}" />
                </StackPanel>
                <Button Grid.Column="2" Content="⏯" Padding="8,4" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play/Pause" />
                <Button Grid.Column="3" Content="👍" Padding="8,4" Command="{Binding ThumbsUpCommand}"
                        IsVisible="{Binding SupportsThumbsUp}" ToolTip.Tip="Thumbs up" />
                <Button Grid.Column="4" Content="👎" Padding="8,4" Command="{Binding ThumbsDownCommand}"
                        IsVisible="{Binding SupportsThumbsDown}" ToolTip.Tip="Thumbs down" />
                <Button Grid.Column="5" Content="⏭" Padding="8,4" Command="{Binding SkipCommand}" ToolTip.Tip="Skip" />
            </Grid>
        </Border>

        <!-- "A newer version exists" — one quiet line, docked above the tabs, shown only when a
             check actually found something newer that hasn't been dismissed. Deliberately not a
             dialog and deliberately not an installer: it links to the releases page and gets out
             of the way. Dismissing hides this version for good (MainWindowViewModel's
             DismissUpdateNotice); "Don't check for updates" here, or Customize → Tell Me About
             New Versions, turns the whole thing off, after which nothing contacts GitHub at all. -->
        <Border DockPanel.Dock="Top" Background="#1F2D3D" BorderBrush="#2CACE8" BorderThickness="0,0,0,1"
                Padding="12,6" IsVisible="{Binding HasUpdateNotice}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding UpdateNotice}" Foreground="White" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="See what's new" FontSize="12" Padding="8,3"
                        Command="{Binding OpenReleasesPageCommand}" />
                <!-- The same switch as Customize → Tell Me About New Versions, turned off from here. -->
                <Button Grid.Column="2" Content="Don't check for updates" FontSize="12" Padding="8,3"
                        Command="{Binding StopUpdateChecksCommand}"
                        ToolTip.Tip="Never check for new versions again. Customize → Tell Me About New Versions turns it back on." />
                <Button Grid.Column="3" Content="✕" FontSize="12" Padding="8,3"
                        Command="{Binding DismissUpdateNoticeCommand}" ToolTip.Tip="Don't tell me about this version again" />
            </Grid>
        </Border>

        <!-- TabStrip (headers only) + a separate content Grid below, rather than a plain
             TabControl (headers+content combined) — see the content Grid's remarks for why:
             a TabControl-hosted overlay ends up covering the header strip too, hiding every
             other tab whenever Music is selected. Splitting them means the header row is
             always its own, always-visible element regardless of what's showing below it. -->
        <Grid RowDefinitions="Auto,*">
            <TabStrip Grid.Row="0" Name="TopLevelTabControl" ItemsSource="{Binding TopLevelTabs}" SelectionChanged="OnTopLevelTabSelectionChanged">
                <TabStrip.Styles>
                    <!-- Underlines the active tab in that bot's own scheme Highlight color, so which bot is open stays obvious even with several tabs open. -->
                    <Style Selector="TabStripItem:selected Border.tabHighlight">
                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                    </Style>
                </TabStrip.Styles>
                <TabStrip.ItemTemplate>
                    <!-- x:CompileBindings=False: TopLevelTabs is `object` (mixing BotTabViewModel,
                         BotGroupTabViewModel, and GlobalWhispersTabViewModel) specifically so this
                         template resolves Title/HighlightBrush/HeaderFontSize/HeaderForeground/
                         HasUnread by reflection against whichever type is actually bound, rather
                         than requiring one shared base type to declare all five. -->
                    <DataTemplate x:CompileBindings="False">
                        <Border Classes="tabHighlight" Background="Transparent" ContextRequested="OnTabHeaderContextRequested" BorderBrush="{Binding HighlightBrush}" BorderThickness="0" Padding="2,2,2,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <!-- Tiny game/client icon — null on a group/Whispers tab with no single game of its own, in which case Image just renders nothing. -->
                                <Image Source="{Binding TabIconImage}" MaxWidth="20" MaxHeight="20" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="{Binding HeaderFontSize}" Foreground="{Binding HeaderForeground}" />
                                <!-- Subtle "something happened while you weren't looking" dot — see
                                     BotTabViewModel/BotGroupTabViewModel/GlobalWhispersTabViewModel's
                                     HasUnread. -->
                                <Ellipse Width="6" Height="6" Fill="#2CACE8" VerticalAlignment="Center" IsVisible="{Binding HasUnread}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>

            <Grid Grid.Row="1">
                <!-- Whichever tab is selected — a plain ContentControl since TabStrip doesn't
                     manage content itself; ViewLocator resolves the right view, the Music tab
                     included (Spotify plays outside Invigoration, so nothing needs keeping alive). -->
                <ContentControl Content="{Binding SelectedTopLevelItem}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
