<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Invigoration.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="360"
        x:Class="Invigoration.App.Views.ProfileWindow"
        x:DataType="vm:ProfileViewModel"
        Width="380" Height="380" CanResize="False"
        Title="Profile">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="{Binding Account}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Spacing="10" IsVisible="{Binding !IsLoading}">
            <StackPanel Spacing="4">
                <TextBlock Text="Sex" Opacity="0.7" FontSize="11" />
                <TextBox Text="{Binding Sex}" IsReadOnly="{Binding !IsOwnAccount}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Age" Opacity="0.7" FontSize="11" />
                <TextBox Text="{Binding Age}" IsReadOnly="True" ToolTip.Tip="Age comes from the account itself and can't be edited here." />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Location" Opacity="0.7" FontSize="11" />
                <TextBox Text="{Binding Location}" IsReadOnly="{Binding !IsOwnAccount}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Description" Opacity="0.7" FontSize="11" />
                <TextBox Text="{Binding Description}" IsReadOnly="{Binding !IsOwnAccount}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
            </StackPanel>
            <TextBlock Text="Read-only — this isn't your logged-in account." Opacity="0.6" FontSize="11"
                       IsVisible="{Binding !IsOwnAccount}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Loading..." IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Save" Command="{Binding SaveCommand}"
                    IsVisible="{Binding IsOwnAccount}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Close" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
