<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Invigoration.App.ViewModels"
        xmlns:cfg="using:Invigoration.Core.Config"
        xmlns:models="using:Invigoration.App.Models"
        xmlns:scr="using:Invigoration.Scr"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="900"
        x:Class="Invigoration.App.Views.ConfigWindow"
        x:DataType="vm:ConfigViewModel"
        Width="680" Height="860"
        Title="Bot Settings">

    <Window.Styles>
        <Style Selector="TextBlock.step">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="Orange" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Pinned: the bot's name, and Save/Cancel always reachable without scrolling. -->
        <Border Grid.Row="0" Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox Grid.Column="0" PlaceholderText="Bot name" Text="{Binding Config.DisplayName}" FontSize="16" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Click="OnCancelClick" />
                    <Button Content="Save" Click="OnSaveClick" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
        <StackPanel Margin="16" Spacing="10">

            <!-- The essentials, in the order they depend on each other: the game decides which
                 login fields and servers apply. Everything else is folded away below; how the
                 bot looks lives under Bot → Appearance. -->

            <!-- 1. Game -->
            <TextBlock Classes="step" Text="1. Game" Margin="0" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Image Grid.Column="0" Source="{Binding ProductIconImage}" Width="40" Height="40" Stretch="Uniform" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <ComboBox ItemsSource="{Binding AvailableProducts}"
                              SelectedValue="{Binding Product}"
                              SelectedValueBinding="{Binding WireCode}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.Styles>
                            <Style Selector="ComboBoxItem" x:DataType="vm:ProductOption">
                                <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                            </Style>
                        </ComboBox.Styles>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding DisplayOpacity}">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="warning" Text="{Binding ServerCompatibilityNote}"
                               IsVisible="{Binding ServerCompatibilityNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Grid>

            <!-- 2. Login -->
            <TextBlock Classes="step" Text="2. Login" />
            <StackPanel Spacing="8">
                <!-- StarCraft II: a saved Battle.net login profile instead of username/password/CD-key -->
                <StackPanel IsVisible="{Binding IsStimpakBackedProduct}" Spacing="8">
                    <TextBlock Classes="label" Text="Battle.net Profile" />
                    <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfile}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="cfg:BattlenetCredentialProfile">
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel IsVisible="{Binding IsCreatingNewProfile}" Orientation="Horizontal" Spacing="8">
                        <TextBox PlaceholderText="Profile name" Text="{Binding NewProfileName}" Width="200" />
                        <Button Content="Create" Command="{Binding CreateProfileCommand}" />
                    </StackPanel>
                    <TextBlock Classes="hint"
                               Text="Reuse a profile to share one Battle.net login across bots, one of them connected at a time; pick + New Profile for a separate login. Signing in happens on Connect, or from File → Manage Battle.net Profiles." />
                </StackPanel>

                <!-- StarCraft: Remastered: the character, which also decides the gateway -->
                <StackPanel IsVisible="{Binding IsNativeScr}" Spacing="8">
                    <TextBlock Classes="label" Text="Character and gateway" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding ScrCharacters}" SelectedItem="{Binding SelectedScrCharacter}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ScrCharacterOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="Sign In &amp; Load Characters" Command="{Binding LoadScrCharactersCommand}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="{Binding ScrCharacterStatus}" />
                    <TextBlock Classes="label" Text="New character" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding ScrGatewayChoices}" SelectedItem="{Binding NewScrCharacterGateway}" MinWidth="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="scr:ScrGateway">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Column="1" Text="{Binding NewScrCharacterName}" PlaceholderText="Character name" />
                        <Button Grid.Column="2" Content="Create" Command="{Binding CreateScrCharacterCommand}"
                                ToolTip.Tip="Creates a StarCraft: Remastered character on this gateway, as the game's character screen does, and selects it." />
                    </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding !IsStimpakBackedProduct}" Spacing="8">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Username" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="Password" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Config.Username}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.Password}" PasswordChar="*" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3" IsVisible="{Binding RequiresCdKey}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="CD key" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="Expansion CD key" IsVisible="{Binding RequiresExpansionKey}" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Config.CdKey}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.ExpansionCdKey}" IsVisible="{Binding RequiresExpansionKey}" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- 3. Server -->
            <TextBlock Classes="step" Text="3. Server" />
            <StackPanel Spacing="8" IsVisible="{Binding !IsStimpakBackedProduct}">
                <TextBlock Classes="label" Text="Server" Margin="0,0,0,-5" />
                <ComboBox ItemsSource="{Binding OfficialServerOptions}"
                          SelectedItem="{Binding SelectedOfficialServer}"
                          IsVisible="{Binding AllowsOfficialServers}"
                          HorizontalAlignment="Stretch" />
                <AutoCompleteBox ItemsSource="{Binding ServerSuggestions}"
                                  Text="{Binding BattlenetServer, Mode=TwoWay}"
                                  PlaceholderText="Pick a suggestion or type any server address"
                                  FilterMode="StartsWith"
                                  IsVisible="{Binding !AllowsOfficialServers}" />
                <AutoCompleteBox ItemsSource="{Binding ServerSuggestions}"
                                  Text="{Binding BattlenetServer, Mode=TwoWay}"
                                  PlaceholderText="Custom server address"
                                  FilterMode="StartsWith"
                                  IsVisible="{Binding ShowsCustomServerBox}" />
                <TextBlock Classes="warning" IsVisible="{Binding ShowsRetiredGameWarning}"
                           Text="Only private/PVPGN servers work for this game — it no longer works on official Battle.net." />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Home channel" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="Port" />
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding HomeChannel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="90" Text="{Binding Config.BattlenetPort}" />
                </Grid>
                <StackPanel Spacing="3" IsVisible="{Binding IsDiabloII}">
                    <TextBlock Classes="label" Text="Realm" />
                    <TextBox PlaceholderText="Leave blank to stay in chat instead of a realm" Text="{Binding Config.Realm}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Classes="warning" IsVisible="{Binding IsStimpakBackedProduct}"
                       Text="These games connect through Battle.net's modern login instead — no server address to set here." />

            <!-- Everything else -->
            <TextBlock Classes="step" Text="More settings" Margin="0,14,0,0" />

            <!-- Grouping lives here, not under Bot → Appearance: it decides how bots are
                 organized, not how one looks, and nobody went looking for it in an appearance
                 window (reported 2026-09-15: "I don't see the grouping as an option at all"). -->
            <Expander Header="Tab group" HorizontalAlignment="Stretch">
                <StackPanel Margin="8" Spacing="8">
                    <TextBox PlaceholderText="Tab group (optional)" Text="{Binding TabGroup}" />
                    <TextBlock Classes="hint"
                               Text="Bots with the same tab group share one top-level tab, each as its own sub-tab — handy for several bots on one server. Leave blank to keep this bot as its own tab." />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsInTabGroup}">
                        <TextBlock Text="Group icon:" VerticalAlignment="Center" Opacity="0.8" FontSize="11" />
                        <ComboBox ItemsSource="{Binding AvailableGroupIcons}" SelectedItem="{Binding SelectedGroupIcon}" Width="240">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:IconOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" />
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="Connection" HorizontalAlignment="Stretch">
                <StackPanel Margin="8" Spacing="8">
                    <CheckBox Content="Connect when the app starts" IsChecked="{Binding Config.AutoConnectOnStartup}" />

                    <CheckBox Content="Reconnect after an unexpected disconnect" IsChecked="{Binding Config.AutoReconnect}" />
                    <StackPanel Spacing="8" Margin="28,0,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Try every" VerticalAlignment="Center" Opacity="0.8" FontSize="12" Margin="0,0,8,0" />
                            <TextBox Width="64" Text="{Binding Config.AutoReconnectDelaySeconds}" />
                            <TextBlock Text="seconds, giving up after" VerticalAlignment="Center" Opacity="0.8" FontSize="12" Margin="8,0" />
                            <TextBox Width="64" Text="{Binding Config.AutoReconnectMaxAttempts}" />
                            <TextBlock Text="attempts (0 = keep trying)" VerticalAlignment="Center" Opacity="0.8" FontSize="12" Margin="8,0,0,0" />
                        </WrapPanel>
                        <TextBlock Classes="hint"
                                   Text="For example, every 45 seconds up to 10 attempts on a server that takes a while to come back. Never after you click Disconnect, or after Battle.net refuses the login (wrong password, closed account, bad CD key) — retrying those would only fail again. On official Battle.net, keep the wait long." />

                        <CheckBox Content="Rapid reconnect (private servers)" IsChecked="{Binding Config.RapidReconnect}"
                                  IsVisible="{Binding !IsStimpakBackedProduct}" />
                        <TextBlock Classes="hint" IsVisible="{Binding UsesBnls}"
                                   Text="For holding a name or channel ops: the first attempt goes out the instant the connection drops, and each attempt skips BNLS by reusing this session's first login answers, getting back on in about half the time. Pair it with a short wait, like every 1 second up to 45 attempts. Never used on official Battle.net." />
                        <TextBlock Classes="hint" IsVisible="{Binding IsChatTelnet}"
                                   Text="For holding a name or channel ops: the first attempt goes out the instant the connection drops. Chat / Telnet is already the fastest way back on — a socket and two credential lines, no BNLS or version check — so pair it with a short wait, like every 1 second up to 45 attempts." />
                    </StackPanel>

                    <TextBlock Classes="label" Text="Flood protection: minimum delay between outgoing messages (ms)" Margin="0,8,0,0" />
                    <TextBox PlaceholderText="Flood protection delay (ms)" Text="{Binding Config.FloodProtectionDelayMs}" />
                    <TextBlock Classes="hint"
                               Text="Every outgoing message waits at least this long after the previous one, so a burst doesn't get the bot disconnected or muted. Raise it if you still get flooded off." />
                </StackPanel>
            </Expander>

            <Expander Header="Commands" HorizontalAlignment="Stretch">
                <StackPanel Margin="8" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox Grid.Column="0" PlaceholderText="Bot master (always has full command access)" Text="{Binding Config.BotMaster}" />
                        <TextBox Grid.Column="1" PlaceholderText="Trigger" Width="70" MaxLength="1" Text="{Binding Config.Trigger}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="The bot master can use every command, in the channel or by whisper. The trigger is the character that starts a command in chat, like ! in !skip." />
                </StackPanel>
            </Expander>

            <Expander Header="Chat" HorizontalAlignment="Stretch">
                <StackPanel Margin="8" Spacing="8">
                    <CheckBox Content="Don't show joins and leaves" IsChecked="{Binding Config.SuppressJoinLeaveNotifications}" />
                    <CheckBox Content="Hide join/leave spam" IsChecked="{Binding Config.HideJoinLeaveSpamEnabled}"
                              IsVisible="{Binding !Config.SuppressJoinLeaveNotifications}" />
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding Config.HideJoinLeaveSpamEnabled}">
                        <TextBlock Grid.Column="0" Text="More than" VerticalAlignment="Center" Opacity="0.8" FontSize="11" />
                        <TextBox Grid.Column="1" Width="50" Text="{Binding Config.HideJoinLeaveSpamThreshold}" />
                        <TextBlock Grid.Column="2" Text="times within (seconds)" VerticalAlignment="Center" Opacity="0.8" FontSize="11" />
                        <TextBox Grid.Column="3" Width="60" Text="{Binding Config.HideJoinLeaveSpamWindowSeconds}" />
                    </Grid>
                    <TextBlock Classes="hint" IsVisible="{Binding Config.HideJoinLeaveSpamEnabled}"
                               Text="Once someone bounces in and out faster than this, their join/leave lines stop showing until they quiet down. Everything else about them still works as normal." />

                    <TextBlock Classes="label" Text="Idle message" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Send after this many quiet minutes (0 = off):" VerticalAlignment="Center" Opacity="0.8" FontSize="11" />
                        <TextBox Grid.Column="1" Width="70" Text="{Binding Config.IdleMinutes}" />
                    </Grid>
                    <TextBox Text="{Binding Config.IdleMessage}" PlaceholderText="e.g. /me is away — currently playing %MusicPlaying%" />
                    <TextBlock Classes="hint"
                               Text="Sent once after the channel's gone quiet, not again until it's busy. Placeholders: %Ver%, %Uptime%, %MusicPlaying% (blank if nothing's playing), %Username%." />
                </StackPanel>
            </Expander>

            <!-- Clan management: this bot's own roster/rank/alias/trivia-score system, off by default like a BNU`Bot plugin toggle -->
            <Expander Header="Clan" HorizontalAlignment="Stretch">
                <StackPanel Margin="8" Spacing="6">
                    <CheckBox Content="Enable clan management for this bot" IsChecked="{Binding Config.ClanFeatureEnabled}" />
                    <TextBlock Classes="hint"
                               Text="Turns on the Clan tab (roster, ranks, aliases, trivia score) for this bot. The roster is shared across every bot you run, so this just opts this bot in — the tab shows once at least one member has been added from the Clan menu." />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                        <TextBox Grid.Column="0" PlaceholderText="Default rank for new chatters" Text="{Binding Config.DefaultRank}" />
                        <TextBox Grid.Column="1" PlaceholderText="Banned rank" Text="{Binding Config.BannedRank}" />
                    </Grid>
                    <TextBlock Classes="hint"
                               Text="Anyone who talks and isn't tracked yet is added with the default rank, so you can hand out real ranks later. Setting someone's rank to the banned value (clanrank &lt;name&gt; &lt;banned rank&gt;) blocks them from every bot command. Leave the default rank blank to turn off auto-adding." />
                </StackPanel>
            </Expander>

            <!-- Trivia: the game itself, separate from clan management above (trivia score just happens to live on the same roster record) -->
            <Expander Header="Trivia" HorizontalAlignment="Stretch">
                <StackPanel Margin="8" Spacing="6">
                    <CheckBox Content="Enable trivia for this bot" IsChecked="{Binding Config.TriviaFeatureEnabled}" />
                    <TextBlock Classes="hint"
                               Text="Turns the !trivia game on or off for this bot. Ships with a starter question pack; drop more .txt files into the Trivia folder (File → Open Config Folder) to add your own." />
                    <TextBox Margin="0,6,0,0" PlaceholderText="Trivia group (optional)" Text="{Binding Config.TriviaGroup}" />
                    <TextBlock Classes="hint"
                               Text="Bots with the same trivia group share one round across their channels — a correct answer on any of them ends it for all. Leave blank to keep this bot's trivia on its own." />
                    <TextBlock Margin="0,10,0,0" Text="Scoring" FontWeight="Bold" Opacity="0.8" />
                    <TextBlock Classes="hint" Text="Points for a correct answer, by how many hints were already shown." />
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Before first hint:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Width="80" Text="{Binding Config.TriviaPointsBeforeFirstHint}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="After first hint:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Width="80" Text="{Binding Config.TriviaPointsAfterFirstHint}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="After second hint:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Width="80" Text="{Binding Config.TriviaPointsAfterSecondHint}" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Discord bridge: connects/disconnects alongside this bot's own Connect/Disconnect, no separate button -->
            <Expander Header="Discord Bridge" HorizontalAlignment="Stretch">
                <StackPanel Margin="8" Spacing="6">
                    <CheckBox Content="Enabled" IsChecked="{Binding Config.Discord.Enabled}" />
                    <TextBox PlaceholderText="Discord bot token (secret)" Text="{Binding Config.Discord.BotToken}" PasswordChar="*" />
                    <TextBox PlaceholderText="Discord channel ID" Text="{Binding Config.Discord.ChannelId}" />
                    <TextBox PlaceholderText="Relay delay (seconds)" Text="{Binding Config.Discord.RelayDelaySeconds}" />
                    <CheckBox Content="Relay Battle.net chat to Discord" IsChecked="{Binding Config.Discord.RelayBattlenetToDiscord}" />
                    <CheckBox Content="Relay Discord messages to Battle.net" IsChecked="{Binding Config.Discord.RelayDiscordToBattlenet}" />
                    <CheckBox Content="Post on Discord as the Battle.net user, with their game logo" IsChecked="{Binding Config.Discord.PostAsBattlenetUsers}" />
                    <TextBlock Classes="hint"
                               Text="Each Battle.net line appears on Discord under the speaker's own name with their game's classic logo. Needs the Discord bot to have Manage Webhooks in that channel (it creates a webhook named &quot;Invigoration Relay&quot;); without it, lines post from the bot. Mentions from Battle.net never ping anyone." />
                    <TextBlock Classes="warning" Margin="0,4,0,0"
                               Text="Requires the bot application's Message Content intent (Discord Developer Portal → Bot). The channel ID is what Discord shows when you right-click a channel with Developer Mode on (User Settings → Advanced)." />
                </StackPanel>
            </Expander>

            <!-- Proxy: routes this bot's connections (BNCS/BNLS/realm) through a SOCKS5 or HTTP CONNECT proxy -->
            <Expander Header="Proxy" HorizontalAlignment="Stretch">
                <StackPanel Margin="8" Spacing="8">
                    <CheckBox Content="Route this bot's connections through a proxy" IsChecked="{Binding ProxyEnabled}" />
                    <StackPanel IsVisible="{Binding ProxyEnabled}" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="ProxyProtocol" Content="SOCKS5" IsChecked="{Binding IsSocks5Proxy}" />
                            <RadioButton GroupName="ProxyProtocol" Content="HTTP CONNECT" IsChecked="{Binding IsHttpProxy}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox Grid.Column="0" PlaceholderText="Proxy host" Text="{Binding Config.ProxyHost}" />
                            <TextBox Grid.Column="1" PlaceholderText="Port" Width="90" Text="{Binding Config.ProxyPort}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <TextBox Grid.Column="0" PlaceholderText="Username (optional)" Text="{Binding Config.ProxyUsername}" />
                            <TextBox Grid.Column="1" PlaceholderText="Password" Text="{Binding Config.ProxyPassword}" PasswordChar="*" />
                        </Grid>
                        <TextBlock Classes="hint"
                                   Text="Applies to every connection this bot makes. Each bot can use a different proxy, so several bots don't all come from one IP — useful when a server limits connections per IP." />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="Ping" HorizontalAlignment="Stretch">
                <StackPanel Margin="8" Spacing="6">
                    <CheckBox Content="Zero ping (fake a near-0ms ping)" IsChecked="{Binding Config.ZeroPing}" />
                    <CheckBox Content="Negative ping (show no ping at all)" IsChecked="{Binding Config.NegPing}" />
                </StackPanel>
            </Expander>

            <Expander Header="Advanced" HorizontalAlignment="Stretch" IsVisible="{Binding UsesBnls}">
                <StackPanel Margin="8" Spacing="8">
                    <TextBlock Classes="label" Text="BNLS server (login helper — change only if it stops working)" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox Grid.Column="0" PlaceholderText="BNLS server" Text="{Binding Config.BnlsServer}" />
                        <TextBox Grid.Column="1" PlaceholderText="Port" Width="90" Text="{Binding Config.BnlsPort}" />
                    </Grid>
                    <TextBlock Classes="label" Text="Version byte override (leave blank for normal)" Margin="0,6,0,0" />
                    <TextBox PlaceholderText="e.g. 0x1A or 26 — blank uses whatever BNLS returns" Text="{Binding Config.VersionByteOverride}" />
                    <TextBlock Classes="hint"
                               Text="Only for a private server pinned to an older client version than BNLS assumes — its version check rejects BNLS's byte. The debug log shows both values when this is set." />
                </StackPanel>
            </Expander>

            <TextBlock Classes="hint" Margin="0,8,0,0"
                       Text="Theme, chat colors and icon set: Bot → Appearance." />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
