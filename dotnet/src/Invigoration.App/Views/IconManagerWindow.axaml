<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Invigoration.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="640"
        x:Class="Invigoration.App.Views.IconManagerWindow"
        x:DataType="vm:IconManagerViewModel"
        Width="540" Height="640"
        Title="Manage Icons">

    <Design.DataContext>
        <vm:IconManagerViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,0,0,10"
                   Text="Replace any chat icon with your own image (PNG/GIF/JPG/BMP) — larger images just render bigger everywhere (up to a cap), no fixed size required. A change takes effect the next time that icon is drawn, e.g. after reconnecting a bot tab." />

        <!-- Whole-collection actions: pick any icon set — the three bundled ones (Battle.net 1.0
             Classic/Warcraft III Classic/Battle.net 2.0) or any of your own saved ones — from one
             combined dropdown, revert everything, or save/apply/delete a named set of your own.
             Each named set is just a folder under the config directory, so it's plain-folder
             backup/portable. -->
        <Border Grid.Row="1" Background="#161616" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding AvailableIconSets}" SelectedItem="{Binding SelectedSet}"
                              PlaceholderText="Choose an icon set..." Width="220" />
                    <Button Content="Apply" Command="{Binding ApplySelectedSetCommand}" IsEnabled="{Binding SelectedSet, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Content="Delete" Command="{Binding DeleteSelectedSetCommand}" IsEnabled="{Binding SelectedSet, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Only removes a saved set of your own — no effect on the three bundled sets." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Reset All to Defaults" Command="{Binding ResetAllIconsCommand}" />
                    <Button Content="Open Icon Sets Folder" Command="{Binding OpenIconSetsFolderCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding NewSetName}" PlaceholderText="New set name..." Width="180" />
                    <Button Content="Save Current As Set" Command="{Binding SaveCurrentAsSetCommand}" IsEnabled="{Binding NewSetName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Game Icons" FontWeight="Bold" Foreground="White" />
                    <ItemsControl ItemsSource="{Binding GameIcons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IconSlotViewModel">
                                <Grid ColumnDefinitions="70,*,Auto,Auto" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <Image Grid.Column="0" Source="{Binding PreviewImage}" MaxHeight="32" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="White" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="2" Content="Change..." Click="OnChangeIconClick" Margin="4,0" />
                                    <Button Grid.Column="3" Content="Reset"
                                            Command="{Binding $parent[ItemsControl].((vm:IconManagerViewModel)DataContext).ResetIconCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding HasOverride}" Margin="4,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Status Badges" FontWeight="Bold" Foreground="White" />
                    <ItemsControl ItemsSource="{Binding StatusIcons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IconSlotViewModel">
                                <Grid ColumnDefinitions="70,*,Auto,Auto" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <Image Grid.Column="0" Source="{Binding PreviewImage}" MaxHeight="32" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="White" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="2" Content="Change..." Click="OnChangeIconClick" Margin="4,0" />
                                    <Button Grid.Column="3" Content="Reset"
                                            Command="{Binding $parent[ItemsControl].((vm:IconManagerViewModel)DataContext).ResetIconCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding HasOverride}" Margin="4,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Friends List" FontWeight="Bold" Foreground="White" />
                    <ItemsControl ItemsSource="{Binding FriendIcons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IconSlotViewModel">
                                <Grid ColumnDefinitions="70,*,Auto,Auto" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <Image Grid.Column="0" Source="{Binding PreviewImage}" MaxHeight="32" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="White" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="2" Content="Change..." Click="OnChangeIconClick" Margin="4,0" />
                                    <Button Grid.Column="3" Content="Reset"
                                            Command="{Binding $parent[ItemsControl].((vm:IconManagerViewModel)DataContext).ResetIconCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding HasOverride}" Margin="4,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Custom Icons" FontWeight="Bold" Foreground="White" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,0,0,4"
                               Text="Not tied to any Blizzard product — connection-type badges and the global Whispers tab's icon." />
                    <ItemsControl ItemsSource="{Binding CustomIcons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IconSlotViewModel">
                                <Grid ColumnDefinitions="70,*,Auto,Auto" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <Image Grid.Column="0" Source="{Binding PreviewImage}" MaxHeight="32" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="White" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="2" Content="Change..." Click="OnChangeIconClick" Margin="4,0" />
                                    <Button Grid.Column="3" Content="Reset"
                                            Command="{Binding $parent[ItemsControl].((vm:IconManagerViewModel)DataContext).ResetIconCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding HasOverride}" Margin="4,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Battle.net 2.0 Games" FontWeight="Bold" Foreground="White" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,0,0,4"
                               Text="Not connectable products yet — kept ready for whenever a Battle.net 2.0 friend/roster entry can report which of these it's actually playing." />
                    <ItemsControl ItemsSource="{Binding Bnet2Icons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IconSlotViewModel">
                                <Grid ColumnDefinitions="70,*,Auto,Auto" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <Image Grid.Column="0" Source="{Binding PreviewImage}" MaxHeight="32" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="White" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="2" Content="Change..." Click="OnChangeIconClick" Margin="4,0" />
                                    <Button Grid.Column="3" Content="Reset"
                                            Command="{Binding $parent[ItemsControl].((vm:IconManagerViewModel)DataContext).ResetIconCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding HasOverride}" Margin="4,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button Content="Close" Click="OnCloseClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
