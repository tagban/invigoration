<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Invigoration.App.ViewModels"
        xmlns:views="using:Invigoration.App.Views"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="720"
        x:Class="Invigoration.App.Views.ThemeManagerWindow"
        x:DataType="vm:ThemeManagerViewModel"
        Width="980" Height="720" MinWidth="760" MinHeight="560"
        Title="Manage Themes">

    <Window.Styles>
        <StyleInclude Source="avares://Invigoration.App/Views/ThemeStyles.axaml" />
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Manage Themes" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="A theme is a bot tab's whole look: frame, user list placement, chat colors and frame colors. Each bot picks one in its Config window."
                               FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Click="OnCloseClick" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- Theme list -->
            <Border Grid.Column="0" Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                        <Button Content="Duplicate" Command="{Binding DuplicateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Content="Delete" Click="OnDeleteClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="1" Margin="0,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="Built-in" FontSize="10" Opacity="0.55" IsVisible="{Binding IsBuiltIn}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Margin="16" Spacing="12">
                    <!-- Live preview, built exactly like a bot tab's chat and input: same gutters,
                         same frame and divider controls, same input-row styles. -->
                    <Border Height="270" ClipToBounds="True" Background="#242424" CornerRadius="4"
                            BorderBrush="#3A3A3A" BorderThickness="1">
                        <Grid RowDefinitions="*,Auto">
                            <Border Grid.Row="0" Margin="{Binding Theme.ChatMargin}" Background="{Binding PreviewBackground}">
                                <ItemsControl ItemsSource="{Binding PreviewLines}" Margin="8,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ThemePreviewLine">
                                            <!-- Runs kept on one line: whitespace between them would render as a leading space on lines with no speaker. -->
                                            <TextBlock FontSize="13" LineHeight="20"><Run Text="{Binding Name}" Foreground="{Binding NameBrush}" /><Run Text="{Binding Text}" Foreground="{Binding TextBrush}" /></TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Grid Grid.Row="1" Margin="{Binding Theme.InputMargin}" ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" PlaceholderText="Type a message or /command..." Classes.themed="{Binding Theme.HasFrame}" />
                                <Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Classes.themed="{Binding Theme.HasFrame}" VerticalAlignment="Stretch" />
                                <Panel Grid.Column="2" Width="42" Height="32" Margin="6,0,0,0" IsVisible="{Binding Theme.ShowChatGem}">
                                    <Ellipse Width="38" Height="28" Fill="{Binding Theme.WellBrush}" Stroke="#000000" StrokeThickness="1" />
                                    <Ellipse Width="36" Height="26" Stroke="{Binding Theme.TrimBrush}" StrokeThickness="2" />
                                    <Panel Width="22" Height="14">
                                        <Path Data="M 11,0 L 22,7 L 11,14 L 0,7 Z" Fill="{Binding PreviewGemBrush}" Stroke="#50000000" StrokeThickness="1" />
                                        <Path Data="M 11,2 L 17,6.5 L 11,5 L 5,6.5 Z" Fill="#70FFFFFF" />
                                    </Panel>
                                </Panel>
                            </Grid>
                            <Panel Grid.Row="0" Grid.RowSpan="2" Margin="4,0,4,4" IsVisible="{Binding Theme.HasFrame}" IsHitTestVisible="False">
                                <views:ThemeFrame DataContext="{Binding Theme}" />
                            </Panel>
                            <Panel Grid.Row="1" Margin="4,2,4,0" VerticalAlignment="Top" IsVisible="{Binding Theme.HasFrame}" IsHitTestVisible="False">
                                <views:ThemeDivider DataContext="{Binding Theme}" />
                            </Panel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ReadOnlyNote}" IsVisible="{Binding !IsEditable}" Foreground="#E0B84A" FontSize="12" TextWrapping="Wrap" />

                    <StackPanel Spacing="10" IsEnabled="{Binding IsEditable}">
                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                            <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />

                            <TextBlock Grid.Row="1" Text="Frame design" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FrameChoices}" SelectedItem="{Binding Frame}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="User list" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LayoutChoices}" SelectedItem="{Binding Layout}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="Chat colors" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ColorChoices}" SelectedItem="{Binding Colors}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Text="Heading font" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding HeaderFont}" PlaceholderText="e.g. Georgia, Times New Roman (blank = the app's font)" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <CheckBox Content="Channel name plate" IsChecked="{Binding ShowNamePlate}" />
                            <CheckBox Content="Chat gem beside Send" IsChecked="{Binding ShowChatGem}" />
                        </StackPanel>

                        <TextBlock Text="Frame colors" FontWeight="Bold" FontSize="12" Opacity="0.85" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding MaterialSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeMaterialSlotViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,16,8">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="12" />
                                            <TextBlock Text="{Binding Hint}" FontSize="10" Opacity="0.55" />
                                        </StackPanel>
                                        <ColorPicker Grid.Column="1" Color="{Binding Value, Mode=TwoWay}" Width="120" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StatusText}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="Save" Command="{Binding SaveCommand}" Padding="20,5" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
