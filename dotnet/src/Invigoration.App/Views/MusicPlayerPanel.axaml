<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Invigoration.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="640"
             x:Class="Invigoration.App.Views.MusicPlayerPanel"
             x:DataType="vm:MusicTabViewModel">

    <!-- MaxWidth + centered: capping the WebView's own rendered width to roughly a mobile
         viewport deliberately triggers YouTube Music's own mobile-responsive layout (confirmed
         live), rather than squeezing its full desktop UI into a narrow space. -->
    <Grid MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <NativeWebView Name="WebView" />
    </Grid>
</UserControl>
