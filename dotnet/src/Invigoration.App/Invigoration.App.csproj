<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\flag.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- ManagedBass (Pandora audio playback) is a pure C# wrapper — the actual native BASS engine
       is a separate download from un4seen.com, free for non-commercial use (this project's
       license: runtimes\BASS-LICENSE.txt). Placing it under runtimes\<RID>\native\ is the
       standard .NET convention: the runtime's own native-library resolver — and, per
       build-windows.ps1's -p:IncludeNativeLibrariesForSelfExtract=true, the single-file
       self-extractor too — already knows to look there for the current RID without any extra
       wiring beyond copying the files to the output/publish directory below. -->
  <ItemGroup>
    <Content Include="runtimes\win-x64\native\bass.dll" Link="runtimes\win-x64\native\bass.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="runtimes\osx-x64\native\libbass.dylib" Link="runtimes\osx-x64\native\libbass.dylib" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="runtimes\osx-arm64\native\libbass.dylib" Link="runtimes\osx-arm64\native\libbass.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ManagedBass" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invigoration.Core\Invigoration.Core.csproj" />
    <ProjectReference Include="..\Invigoration.Sc2\Invigoration.Sc2.csproj" />
  </ItemGroup>

  <Import Project="..\StimpakPackage.props" />
</Project>
