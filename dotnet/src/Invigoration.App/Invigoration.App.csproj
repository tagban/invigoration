<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\flag.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invigoration.Core\Invigoration.Core.csproj" />
    <ProjectReference Include="..\Invigoration.Sc2\Invigoration.Sc2.csproj" />
    <!--
      Referenced directly (not just transitively through Core) with the exact
      same AdditionalProperties Core uses — otherwise MSBuild treats Core's
      configured instance and App's transitive view of it as two different
      project instances (different global-property sets), builds Stimpak
      twice, and App's own output-copy step picks up the *other* (default,
      unrenamed) instance. See Invigoration.Core.csproj's own comment on why
      AssemblyName is overridden at all.
    -->
    <ProjectReference Include="..\..\..\native\superiority\stimpak\csharp\Stimpak\Stimpak.csproj">
      <AdditionalProperties>StimpakBuildNative=false;AssemblyName=Stimpak.Managed</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Import Project="..\StimpakNativeAssets.props" />
</Project>
